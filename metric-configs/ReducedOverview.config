version: 7

subMetrics:
- sub: &pct
  - { name: Utilization , suffix: .avg.pct_of_peak_sustained_elapsed , maxValue: 100 }
- sub: &hertz
  - { name: Hz          , suffix: .avg.per_second }
- sub: &count_and_pct
  - { name: Utilization , suffix: .avg.pct_of_peak_sustained_elapsed , maxValue: 100 }
  - { name: Total       , suffix: .sum }

# Deliberately small: these are always on, so every metric costs budget on every run.
metricSets:
# Blackwell datacenter.
- name: Nsight Perf Reduced Overview GB10x (experimental)
  gpu: [gb100, gb102, gb110, gb112]
  metrics:
  - { name: GPC Clock              , id: gpc__cycles_elapsed                                    , subMetrics: *hertz , color: "#9E9E9E" , description: "Graphics clock. A dip here explains a throughput dip the activity rows do not." }
  - { name: SYS Clock              , id: sys__cycles_elapsed                                    , subMetrics: *hertz , color: "#BDBDBD" , description: "System clock, which drives the fixed-function and host-facing blocks." }
  - { name: GR Active              , id: gr__cycles_active                                      , subMetrics: *pct   , color: "#1E88E5" , description: "The combined 3D and compute engine is executing work." }
  - { name: SM Active              , id: sm__cycles_active                                      , subMetrics: *pct   , color: "#43A047" , description: "SMs have warps resident. High here with low SM Issue means warps are stalled, not absent." }
  - { name: SM Issue               , id: sm__inst_executed_realtime                             , subMetrics: *pct   , color: "#7CB342" , description: "SMs are issuing instructions. This is the closest thing to useful compute throughput." }
  - { name: Tensor Active          , id: sm__pipe_tensor_cycles_active_realtime                 , subMetrics: *pct   , color: "#00ACC1" , description: "Tensor pipes are busy. Low on a matmul workload points at shape or layout, not occupancy." }
  - { name: DRAM Read              , id: dram__bytes_read                                       , subMetrics: *pct   , color: "#FB8C00" , description: "Read traffic to onboard DRAM, as a share of peak." }
  - { name: DRAM Write             , id: dram__bytes_write                                      , subMetrics: *pct   , color: "#F4511E" , description: "Write traffic to onboard DRAM, as a share of peak." }
  - { name: Compute Warp Occupancy , id: TPC.TriageCompute.tpc__warps_active_shader_cs_realtime , subMetrics: *pct   , color: "#26A69A" , description: "Share of warp slots holding compute warps. Low means the launch is too small to fill the GPU." }
  - { name: PCIe RX                , id: PCI.TriageCompute.pcie__read_bytes                     , subMetrics: *pct   , color: "#8E24AA" , description: "Host-to-device traffic. Sustained high here usually means the input pipeline is the limit." }
  - { name: PCIe TX                , id: PCI.TriageCompute.pcie__write_bytes                    , subMetrics: *pct   , color: "#5E35B1" , description: "Device-to-host traffic, typically results and copies back." }
  metricGroups: &groups
  - name: GPU Activity
    description: "How busy the GPU's compute path is. GR covers the combined 3D and compute engine.\n"
    metrics: [GR Active, SM Active, SM Issue, Tensor Active, Compute Warp Occupancy]
    subMetrics: *pct
    aggregationOp: max
  - name: DRAM Bandwidth
    description: "Onboard DRAM traffic. Read and write alternate on a half-duplex interface, so the row sums them.\n"
    metrics: [DRAM Read, DRAM Write]
    subMetrics: *pct
    aggregationOp: sum
  - name: PCIe Bandwidth
    description: "Host traffic. PCIe is full duplex, so RX and TX can move at once and the row takes the larger.\n"
    metrics: [PCIe RX, PCIe TX]
    subMetrics: *pct
    aggregationOp: max
  - name: GPU Clocks
    description: "Clock frequencies. A drop here explains a throughput drop that the activity rows do not.\n"
    metrics: [GPC Clock, SYS Clock]
    subMetrics: *hertz
    aggregationOp: max
  timelineViews: &views
  - name: Default
    rows:
    - metricGroup: GPU Activity
      heightScale: 3
    - metricGroup: DRAM Bandwidth
    - metricGroup: PCIe Bandwidth
    - metricGroup: GPU Clocks

# Blackwell consumer.
- name: Nsight Perf Reduced Overview GB20x (experimental)
  gpu: [gb202, gb203, gb205, gb206, gb207]
  metrics:
  - { name: GPC Clock              , id: gpc__cycles_elapsed                    , subMetrics: *hertz , color: "#9E9E9E" , description: "Graphics clock. A dip here explains a throughput dip the activity rows do not." }
  - { name: SYS Clock              , id: sys__cycles_elapsed                    , subMetrics: *hertz , color: "#BDBDBD" , description: "System clock, which drives the fixed-function and host-facing blocks." }
  - { name: GR Active              , id: gr__cycles_active                      , subMetrics: *pct   , color: "#1E88E5" , description: "The combined 3D and compute engine is executing work." }
  - { name: SM Active              , id: sm__cycles_active                      , subMetrics: *pct   , color: "#43A047" , description: "SMs have warps resident. High here with low SM Issue means warps are stalled, not absent." }
  - { name: SM Issue               , id: sm__inst_executed_realtime             , subMetrics: *pct   , color: "#7CB342" , description: "SMs are issuing instructions. This is the closest thing to useful compute throughput." }
  - { name: Tensor Active          , id: sm__pipe_tensor_cycles_active_realtime , subMetrics: *pct   , color: "#00ACC1" , description: "Tensor pipes are busy. Low on a matmul workload points at shape or layout, not occupancy." }
  - { name: Compute Warp Occupancy , id: tpc__warps_active_shader_cs_realtime   , subMetrics: *pct   , color: "#26A69A" , description: "Share of warp slots holding compute warps. Low means the launch is too small to fill the GPU." }
  - { name: DRAM Read              , id: dram__bytes_op_read                    , subMetrics: *pct   , color: "#FB8C00" , description: "Read traffic to onboard DRAM, as a share of peak." }
  - { name: DRAM Write             , id: dram__bytes_op_write                   , subMetrics: *pct   , color: "#F4511E" , description: "Write traffic to onboard DRAM, as a share of peak." }
  - { name: PCIe RX                , id: pcie__read_bytes                       , subMetrics: *pct   , color: "#8E24AA" , description: "Host-to-device traffic. Sustained high here usually means the input pipeline is the limit." }
  - { name: PCIe TX                , id: pcie__write_bytes                      , subMetrics: *pct   , color: "#5E35B1" , description: "Device-to-host traffic, typically results and copies back." }
  metricGroups: *groups
  timelineViews: *views

# DGX Spark.
- name: Nsight Perf Reduced Overview GB20B (experimental)
  gpu: [gb20b]
  metrics:
  - { name: SM Instructions , id: sm__inst_executed                      , subMetrics: *count_and_pct , color: "#43A047" , description: "Instructions the SMs executed, as a count and as a share of peak." }
  - { name: Tensor Active   , id: sm__pipe_tensor_cycles_active_realtime , subMetrics: *pct           , color: "#00ACC1" , description: "Tensor pipes are busy. Low on a matmul workload points at shape or layout, not occupancy." }
  metricGroups:
  - name: GPU Activity
    description: "How busy the GPU's compute path is.\n"
    metrics: [SM Instructions, Tensor Active]
    subMetrics: *pct
    aggregationOp: max
  timelineViews:
  - name: Default
    rows:
    - metricGroup: GPU Activity
      heightScale: 3

# Rubin: port the GB100 overview with GR100 metric names.
- name: Nsight Perf Reduced Overview GR100 (experimental)
  gpu: [gr100]
  metrics:
  - { name: GPC Clock              , id: gpc__cycles_elapsed                          , subMetrics: *hertz , color: "#9E9E9E" , description: "Graphics clock. A dip here explains a throughput dip the activity rows do not." }
  - { name: SYS Clock              , id: sys__cycles_elapsed                          , subMetrics: *hertz , color: "#BDBDBD" , description: "System clock, which drives the fixed-function and host-facing blocks." }
  - { name: GR Active              , id: gr__cycles_active                            , subMetrics: *pct   , color: "#1E88E5" , description: "The combined 3D and compute engine is executing work." }
  - { name: SM Active              , id: sm__cycles_active                            , subMetrics: *pct   , color: "#43A047" , description: "SMs have warps resident. High here with low SM Issue means warps are stalled, not absent." }
  - { name: SM Issue               , id: sm__inst_executed_realtime                   , subMetrics: *pct   , color: "#7CB342" , description: "SMs are issuing instructions. This is the closest thing to useful compute throughput." }
  - { name: Tensor Active          , id: sm__pipe_tensor_cycles_active_realtime       , subMetrics: *pct   , color: "#00ACC1" , description: "Tensor pipes are busy. Low on a matmul workload points at shape or layout, not occupancy." }
  - { name: DRAM Read              , id: dram__read_throughput                        , subMetrics: *pct   , color: "#FB8C00" , description: "Read traffic to onboard DRAM, as a share of peak." }
  - { name: DRAM Write             , id: dram__write_throughput                       , subMetrics: *pct   , color: "#F4511E" , description: "Write traffic to onboard DRAM, as a share of peak." }
  - { name: Compute Warp Occupancy , id: tpc__warps_active_shader_cs_realtime         , subMetrics: *pct   , color: "#26A69A" , description: "Share of warp slots holding compute warps. Low means the launch is too small to fill the GPU." }
  - { name: PCIe RX                , id: pcie__read_bytes                             , subMetrics: *pct   , color: "#8E24AA" , description: "Host-to-device traffic. Sustained high here usually means the input pipeline is the limit." }
  - { name: PCIe TX                , id: pcie__write_bytes                            , subMetrics: *pct   , color: "#5E35B1" , description: "Device-to-host traffic, typically results and copies back." }
  metricGroups: *groups
  timelineViews: *views
