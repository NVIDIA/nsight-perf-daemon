# NOTE: Metrics representing a superset of other metrics must be declared first
# if they appear in the same group (displayRows). Otherwise different metrics will
# dominate in the group row depending on zoom level if overlay display mode is used.
version: 7

subMetrics:
- sub: &counts
  - { name: Total, suffix: .sum }
- sub: &throughput
  - { name: Throughput %, suffix: .avg.pct_of_peak_sustained_elapsed }
- sub: &throughput_and_count
  - *throughput
  - *counts
- sub: &avg_bytes
  - { name: Bytes/SM, suffix: .avg.per_cycle_elapsed, maxValueSuffix: .avg.peak_sustained }
- sub: &avg_bytes_tpc
  - { name: Bytes/SM, suffix: .avg.per_cycle_elapsed, maxValueSuffix: .avg.peak_sustained, multiplier: .5 }
- sub: &bandwidth
  - *throughput
  - { name: Bytes, suffix: .sum }
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 1.e-9 }
- sub: &bandwidth_no_peak
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 1.e-9 }
  - { name: Bytes, suffix: .sum }
- sub: &bandwidth_requests_constant
  - *throughput
  - { name: Bytes, suffix: .sum, multiplier: 64 }
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 64.e-9 }
- sub: &bandwidth_requests_instruction
  - *throughput
  - { name: Bytes, suffix: .sum, multiplier: 128 }
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 128.e-9 }
- sub: &bandwidth_sectors
  - *throughput
  - { name: Bytes, suffix: .sum, multiplier: 32 }
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 32.e-9 }
- sub: &capacity
  - { name: kB, suffix: .ratio, maxValueSuffix: .max_rate, multiplier: 1e-3 }
- sub: &ctas
  - { name: CTAs/us, suffix: .sum.per_second, multiplier: 1e-6 }
  - { name: CTAs, suffix: .sum }
- sub: &ctas_sm
  - *throughput
  - { name: Avg CTAs per SM, suffix: .avg.per_cycle_elapsed }
- sub: &ctas_sm_tpc
  - *throughput
  - { name: Avg CTAs per SM, suffix: .avg.per_cycle_elapsed, multiplier: 0.5 }
- sub: &cycles
  - { name: Cycles, suffix: .sum }
- sub: &throughput_and_cycles
  - *throughput
  - *cycles
- sub: &hertz
  - { name: MHz, suffix: .avg.per_second, multiplier: 1.e-6 }
  - { name: Cycles, suffix: .avg }
- sub: &inst_ratio
  - { name: Threads/Warp, suffix: .ratio, maxValueSuffix: .max_rate }
  - { name: Coherence, suffix: .pct }
- sub: &pixels
  - { name: Pixels-per-Cycle, suffix: .avg.per_cycle_elapsed, maxValueSuffix: .avg.peak_sustained }
  - *throughput
  - { name: Pixels, suffix: .sum }
- sub: &primitive_rate
  - *throughput
  - { name: Prim/GPC, suffix: .avg }
  - { name: Primitives, suffix: .sum }
- sub: &ratio
  - { name: Ratio %, suffix: .pct, maxValueSuffix: .max_rate }
- sub: &registers
  - { name: Occupancy %, suffix: .avg.pct_of_peak_sustained_elapsed }
  - { name: Avg Registers per SM, suffix: .avg.per_cycle_elapsed }
- sub: &registers_tpc
  - { name: Occupancy %, suffix: .avg.pct_of_peak_sustained_elapsed }
  - { name: Avg Registers per SM, suffix: .avg.per_cycle_elapsed, multiplier: 0.5 }
- sub: &threads_count
  - { name: Threads/us, suffix: .sum.per_second, multiplier: 1e-6 }
  - { name: Threads, suffix: .sum }
- sub: &warps
  - { name: Avg Warps, suffix: .avg.per_cycle_elapsed, maxValueSuffix: .avg.peak_sustained }
  - { name: Occupancy %, suffix: .avg.pct_of_peak_sustained_elapsed  }
- sub: &warps_count
  - { name: Warps/us, suffix: .sum.per_second, multiplier: 1e-6 }
  - { name: Warps, suffix: .sum }
- sub: &warps_tpc
  - { name: Avg Warps, suffix: .avg.per_cycle_elapsed, maxValueSuffix: .avg.peak_sustained, multiplier: .5 }
  - { name: Occupancy %, suffix: .avg.pct_of_peak_sustained_elapsed  }

metricSets:
- name: Top-Level Overview Metrics for NVIDIA GB20y
  chips: [GB20B, GB20C]

  customMetricDefinitions:
  - Top_Level_Overview.ScreenPipe_throughput:
      throughput:
      - prop__prop2crop_pixels_realtime
      - rop__throughput
      - prop__prop2zrop_pixels_realtime
      - stri__throughput
  - Top_Level_Overview.WorldPipe_throughput:
      throughput:
      - pda__input_verts_realtime
      - pda__input_prims_realtime
      - vaf__throughput_realtime
      - tpc__vaf2mio_phase_alpha_cycles_active
      - tpc__vaf2mio_phase_beta_cycles_active
  - Top_Level_Overview.bytes_per_l1tex_line:
      conversionFactor:
        dimunits: DimUnit.bytes / DimUnit.l1tex_lines
        multiplier: 128.0
  - Top_Level_Overview.l1data_bank_conflicts_to_l1tex_wavefronts_conversion_factor:
      conversionFactor:
        dimunits: DimUnit.l1tex_wavefronts / DimUnit.l1data_bank_conflicts
        multiplier: 1.0
  - Top_Level_Overview.tpc__warps_active_realtime:
      counter:
        expr: tpc__warps_active_shader_vtg_realtime + tpc__warps_active_shader_ps_realtime + tpc__warps_active_shader_cs_queue_sync_realtime + tpc__warps_active_shader_cs_queue_async_realtime
        sustainedRate: 96.0
  - Top_Level_Overview.l1tex__average_cache_bytes_per_warp:
      ratio:
        expr: tpc__l1tex_sram_bytes_mem_tagged_realtime, RollupOp.avg, Top_Level_Overview.tpc__warps_active_realtime, RollupOp.avg
        maxRate: 128*1024
  - Top_Level_Overview.l1tex_data_bytes_per_wavefronts:
      conversionFactor:
        dimunits: DimUnit.bytes / DimUnit.l1tex_wavefronts
        multiplier: 128.0
  - Top_Level_Overview.l1tex__data_pipe_lsu_bytes_mem_shared:
      counter:
        expr: l1tex__data_pipe_lsu_wavefronts_mem_shared * Top_Level_Overview.l1tex_data_bytes_per_wavefronts
        sustainedRate: 128.0
  - Top_Level_Overview.l1tex__data_pipe_lsu_wavefronts_mem_surface:
      counter:
        expr: l1tex__data_pipe_lsu_wavefronts - l1tex__data_pipe_lsu_wavefronts_mem_lgds - l1tex__data_pipe_lsu_wavefronts_mem_shared
        sustainedRate: 1.0
  - Top_Level_Overview.l1tex__throughput:
      throughput:
      - l1tex__sram_cycles_array_0_cmd_read
      - l1tex__sram_cycles_array_0_cmd_write
      - l1tex__sram_cycles_array_1_cmd_read
      - l1tex__sram_cycles_array_1_cmd_write
      - l1tex__data_pipe_lsu_wavefronts
      - l1tex__lsu_writeback_active
      - l1tex__data_pipe_tex_wavefronts
      - l1tex__f_wavefronts_realtime
      - l1tex__tex_writeback_active
      - l1tex__m_xbar2l1tex_read_sectors_realtime
      - l1tex__samp_wavefronts
      - tpc__l1tex_m_l1tex2xbar_req_cycles_active
  - Top_Level_Overview.lts__cbc_requests_type_comptag_realtime:
      counter:
        expr: lts__cbc_requests_type_comptag_lookup_hit_realtime + lts__cbc_requests_type_comptag_lookup_miss_or_hit_to_miss_realtime
        sustainedRate: 1.0
      description: '# of compressible requests handled by CBC'
  - Top_Level_Overview.lts__average_cbc_hit_rate_realtime:
      description: proportion of requests that hit in CBC
      ratio:
        expr: lts__cbc_requests_type_comptag_lookup_hit_realtime, RollupOp.sum, Top_Level_Overview.lts__cbc_requests_type_comptag_realtime, RollupOp.sum
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcnode_gpc_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcnode_gpc_realtime - lts__t_sectors_srcnode_gpc_lookup_miss_realtime
        sustainedRate: 2.0
      description: '# of LTS sectors from node GPC that hit'
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcnode_gpc_realtime:
      description: proportion of L2 sector lookups from node GPC that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcnode_gpc_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcnode_gpc_realtime, RollupOp.sum
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcunit_ce_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_ce_realtime - lts__t_sectors_srcunit_ce_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit CE that hit'
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_ce_realtime:
      description: proportion of L2 sector lookups from unit CE that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_ce_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_ce_realtime, RollupOp.sum
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcunit_crop_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_crop_realtime - lts__t_sectors_srcunit_crop_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit CROP that hit'
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_crop_realtime:
      description: proportion of L2 sector lookups from unit CROP that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_crop_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_crop_realtime, RollupOp.sum
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcunit_gcc_op_read_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_gcc_realtime - lts__t_sectors_srcunit_gcc_op_read_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit GCC that hit'
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_gcc_op_read_realtime:
      description: proportion of L2 sector lookups from unit GCC that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_gcc_op_read_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_gcc_realtime, RollupOp.sum
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcunit_pe_op_read_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_pe_op_read_realtime - lts__t_sectors_srcunit_pe_op_read_lookup_miss_realtime
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_pe_op_read_realtime:
      description: proportion of L2 sector lookups from unit PE for read that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_pe_op_read_lookup_hit_realtime, RollupOp.avg, lts__t_sectors_srcunit_pe_op_read_realtime, RollupOp.avg
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcunit_pe_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_pe_realtime - lts__t_sectors_srcunit_pe_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit PE that hit'
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_pe_realtime:
      description: proportion of L2 sector lookups from unit PE that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_pe_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_pe_realtime, RollupOp.sum
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcunit_raster_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_raster_realtime - lts__t_sectors_srcunit_raster_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit RASTER that hi'
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_raster_realtime:
      description: proportion of L2 sector lookups from unit Raster that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_raster_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_raster_realtime, RollupOp.sum
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcunit_tex_op_atom_realtime:
      counter:
        expr: lts__t_sectors_srcunit_tex_realtime - lts__t_sectors_srcunit_tex_op_read_realtime - lts__t_sectors_srcunit_tex_op_write_realtime
  - Top_Level_Overview.lts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime:
      counter:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_tex_op_atom_realtime - (lts__t_sectors_srcunit_tex_lookup_miss_realtime - lts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime - lts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime)
        sustainedRate: 1.0
      description: '# of LTS sectors from unit L1TEX for all atomics or reductions that hit'
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_tex_op_atom_realtime:
      description: proportion of L2 sector lookups from unit L1TEX for atomics or reductions that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime, RollupOp.avg, Top_Level_Overview.lts__t_sectors_srcunit_tex_op_atom_realtime, RollupOp.avg
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_tex_op_read_realtime - lts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime
        sustainedRate: 2.0
      description: '# of LTS sectors from unit L1TEX for all reads that hit'
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_tex_op_read_realtime:
      description: proportion of L2 sector lookups from unit L1TEX for reads that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime, RollupOp.avg, lts__t_sectors_srcunit_tex_op_read_realtime, RollupOp.avg
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_tex_op_write_realtime - lts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit L1TEX for all writes that hit'
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_tex_op_write_realtime:
      description: proportion of L2 sector lookups from unit L1TEX for writes that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime, RollupOp.avg, lts__t_sectors_srcunit_tex_op_write_realtime, RollupOp.avg
        maxRate: 1.0
  - Top_Level_Overview.lts__t_sectors_srcunit_zrop_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_zrop_realtime - lts__t_sectors_srcunit_zrop_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit PROP that hit'
  - Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_zrop_realtime:
      description: proportion of L2 sector lookups from unit ZROP that hit
      ratio:
        expr: Top_Level_Overview.lts__t_sectors_srcunit_zrop_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_zrop_realtime, RollupOp.sum
        maxRate: 1.0
  - Top_Level_Overview.lts__throughput:
      description: LTS Throughput
      throughput:
      - lts__t_sectors_realtime
      - lts__lts2xbar_cycles_active_realtime
      - lts__xbar2lts_cycles_active
      - lts__t_requests
      - lts__d_atomic_input_cycles_active
      - Top_Level_Overview.lts__cbc_requests_type_comptag_realtime
      - lts__d_decomp_input_sectors_realtime
      - lts__d_sectors_fill_device
  - Top_Level_Overview.max_warps_per_tpc:
      conversionFactor:
        dimunits: DimUnit.warps
        multiplier: 96.0
  - Top_Level_Overview.registers_per_rf_quantum:
      conversionFactor:
        dimunits: DimUnit.registers / DimUnit.rf_quanta
        multiplier: 256.0
  - Top_Level_Overview.rtcore__throughput:
      description: RTCORE Throughput
      throughput:
      - rtcore__cycles_executed
  - Top_Level_Overview.sm__thread_inst_executed_pred_on_per_inst_executed_realtime:
      description: '[DEPRECATED: use sm__average_thread_inst_executed_pred_on_per_inst_executed_realtime instead]'
      ratio:
        expr: sm__thread_inst_executed_pred_on_realtime, RollupOp.avg, sm__inst_executed_realtime, RollupOp.avg
        maxRate: 32.0
  - Top_Level_Overview.sm__threads_launched_shader_ps_killmask_off_realtime:
      counter:
        expr: sm__threads_launched_shader_ps_killmask_off_output_killed_reason_discard_realtime + sm__threads_launched_shader_ps_killmask_off_output_killed_reason_coverage_mask_realtime
        sustainedRate: 16.0
      description: '# of PS threads launched in not-killed state (with sample coverage)'
  - Top_Level_Overview.sm__throughput:
      throughput:
      - sm__inst_executed_realtime
      - sm__inst_executed_pipe_xu_realtime
      - sm__inst_executed_pipe_uniform_realtime
      - sm__pipe_tensor_cycles_active_realtime
      - sm__inst_executed_pipe_aluheavy_realtime
      - sm__pipe_fmaheavy_cycles_active_realtime
      - sm__pipe_fmalite_cycles_active_realtime
  - Top_Level_Overview.threads_per_warp:
      conversionFactor:
        dimunits: DimUnit.threads / DimUnit.warps
        multiplier: 32.0
  - Top_Level_Overview.tpc__warps_launched_shader_realtime:
      counter:
        expr: tpc__warps_launched_shader_vtg_realtime + tpc__warps_launched_shader_ps + tpc__warps_launched_shader_cs_queue_sync + tpc__warps_launched_shader_cs_queue_async
        sustainedRate: 32.0
      description: '# threads launched per warp'
  - Top_Level_Overview.tpc__average_threads_launched_per_warp:
      description: '# threads launched per warp'
      ratio:
        expr: tpc__threads_launched_realtime, RollupOp.sum, Top_Level_Overview.tpc__warps_launched_shader_realtime, RollupOp.sum
        maxRate: 32.0
  - Top_Level_Overview.tpc__average_threads_launched_per_warp_shader_ps:
      description: '# PS threads launched per warp'
      ratio:
        expr: tpc__threads_launched_shader_ps_realtime, RollupOp.sum, tpc__warps_launched_shader_ps, RollupOp.sum
        maxRate: 16.0
  - Top_Level_Overview.tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_queue_async_realtime:
      counter:
        expr: tpc__l1tex_sram_lines_mem_untagged_data_shared_allocated_compute_queue_async_realtime * Top_Level_Overview.bytes_per_l1tex_line
        sustainedRate: 204800.0
      description: 'cumulative # of shared memory bytes allocated by active CTAs launched from any async queue'
  - Top_Level_Overview.tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_queue_sync_realtime:
      counter:
        expr: tpc__l1tex_sram_lines_mem_untagged_data_shared_allocated_compute_queue_sync_realtime * Top_Level_Overview.bytes_per_l1tex_line
        sustainedRate: 204800.0
      description: 'cumulative # of shared memory bytes allocated by active CTAs launched from the direct queue'
  - Top_Level_Overview.tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_isbe_realtime:
      counter:
        expr: tpc__l1tex_sram_lines_mem_untagged_data_shared_allocated_isbe_realtime * Top_Level_Overview.bytes_per_l1tex_line
        sustainedRate: 172032.0
      description: 'cumulative # of ISBE bytes allocated by VTG warps'
  - Top_Level_Overview.tpc__l1tex_sram_bytes_mem_untagged_data_shared_unallocated_realtime:
      counter:
        expr: tpc__l1tex_sram_bytes_mem_untagged_data_shared_realtime - (Top_Level_Overview.tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_queue_sync_realtime + Top_Level_Overview.tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_queue_async_realtime + Top_Level_Overview.tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_isbe_realtime)
        sustainedRate: 204800.0
      description: 'cumulative # of shared memory bytes unallocated'
  - Top_Level_Overview.tpc__l1tex_sram_bytes_mem_untagged_data_tram_allocated_realtime:
      counter:
        expr: tpc__l1tex_sram_lines_mem_untagged_data_tram_allocated_realtime * Top_Level_Overview.bytes_per_l1tex_line
        sustainedRate: 32768.0
      description: 'cumulative # of TRAM bytes allocated by PS warps'
  - Top_Level_Overview.tpc__sm_rf_registers_allocated_shader_ps_realtime:
      counter:
        expr: tpc__sm_rf_quanta_allocated_shader_ps_realtime * Top_Level_Overview.registers_per_rf_quantum
        sustainedRate: 131072.0
      description: 'cumulative # of registers allocated by active PS warps'
  - Top_Level_Overview.tpc__sm_rf_registers_allocated_shader_vtg_realtime:
      counter:
        expr: (tpc__sm_rf_quanta_allocated_realtime - tpc__sm_rf_quanta_allocated_shader_ps_realtime - tpc__sm_rf_quanta_allocated_shader_cs_queue_sync_realtime - tpc__sm_rf_quanta_allocated_shader_cs_queue_async_realtime) * Top_Level_Overview.registers_per_rf_quantum
        sustainedRate: 131072.0
      description: 'cumulative # of registers allocated by active VTG warps'
  - Top_Level_Overview.tpc__threads_launched_shader_cs_and_vtg_realtime:
      counter:
        expr: tpc__threads_launched_realtime - tpc__threads_launched_shader_ps_realtime
        sustainedRate: 1.125
      description: '# of VTG+CS warps launched'
  - Top_Level_Overview.tpc__threads_launched_shader_ps_killmask_off_realtime:
      counter:
        expr: RerollUp(Top_Level_Overview.sm__threads_launched_shader_ps_killmask_off_realtime, RollupOp.sum, HwUnit.tpc)
        sustainedRate: 16.0
      description: '# of PS threads launched in not-killed state (with sample coverage)'
  - Top_Level_Overview.tpc__threads_launched_shader_ps_killmask_on_realtime:
      counter:
        expr: tpc__threads_launched_shader_ps_realtime - Top_Level_Overview.tpc__threads_launched_shader_ps_killmask_off_realtime
        sustainedRate: 16.0
      description: '# of PS threads launched in killed state (lacking sample coverage)'
  - Top_Level_Overview.tpc__threads_unused:
      counter:
        expr: (Top_Level_Overview.tpc__warps_launched_shader_realtime * Top_Level_Overview.threads_per_warp) - tpc__threads_launched_realtime
        sustainedRate: 32.0
      description: '# unused threads'
  - Top_Level_Overview.tpc__warps_inactive_sm_active_realtime:
      counter:
        expr: RerollUp(sm__cycles_active, RollupOp.avg, HwUnit.tpc) * Top_Level_Overview.max_warps_per_tpc - (tpc__warps_active_shader_cs_queue_sync_realtime + tpc__warps_active_shader_cs_queue_async_realtime + tpc__warps_active_shader_ps_realtime + tpc__warps_active_shader_vtg_realtime)
        sustainedRate: 96.0
  - GPUTrace.l1tex__data_pipe_lsu_wavefronts_mem_shared_op_nonmisc:
      counter:
        description: ''
        expr: l1tex__data_pipe_lsu_wavefronts_mem_shared_op_atom + l1tex__data_pipe_lsu_wavefronts_mem_shared_op_ld + l1tex__data_pipe_lsu_wavefronts_mem_shared_op_ldgsts + l1tex__data_pipe_lsu_wavefronts_mem_shared_op_st
  - GPUTrace.sm__throughput:
      throughput:
      - sm__inst_executed_realtime
      - sm__inst_executed_pipe_aluheavy_realtime
      - sm__inst_executed_pipe_alu_size_64b_realtime
      - sm__inst_executed_pipe_fma_realtime
      - sm__inst_executed_pipe_fmaheavy_realtime
      - sm__pipe_fmaheavy_cycles_active_realtime
      - sm__inst_executed_pipe_xu_realtime
      - sm__pipe_tensor_cycles_active_realtime
      - sm__inst_executed_pipe_uniform_realtime

