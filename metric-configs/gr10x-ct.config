# NOTE: Metrics representing a superset of other metrics must be declared first
# if they appear in the same group (displayRows). Otherwise different metrics will
# dominate in the group row depending on zoom level if overlay display mode is used.
version: 7

subMetrics:
- sub: &counts
  - { name: Total, suffix: .sum }
- sub: &throughput
  - { name: Throughput %, suffix: .avg.pct_of_peak_sustained_elapsed }
- sub: &throughput_and_count
  - *throughput
  - *counts
- sub: &avg_bytes
  - { name: Bytes/SM, suffix: .avg.per_cycle_elapsed, maxValueSuffix: .avg.peak_sustained }
- sub: &avg_bytes_tpc
  - { name: Bytes/SM, suffix: .avg.per_cycle_elapsed, maxValueSuffix: .avg.peak_sustained, multiplier: .5 }
- sub: &bandwidth
  - *throughput
  - { name: Bytes, suffix: .sum }
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 1.e-9 }
- sub: &bandwidth_requests_constant
  - *throughput
  - { name: Bytes, suffix: .sum, multiplier: 64 }
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 64.e-9 }
- sub: &bandwidth_requests_instruction
  - *throughput
  - { name: Bytes, suffix: .sum, multiplier: 128 }
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 128.e-9 }
- sub: &bandwidth_sectors
  - *throughput
  - { name: Bytes, suffix: .sum, multiplier: 32 }
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 32.e-9 }
- sub: &bandwidth_wavefronts
  - *throughput
  - { name: Bytes, suffix: .sum, multiplier: 128 }
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 128.e-9 }
- sub: &capacity
  - { name: kB, suffix: .ratio, maxValueSuffix: .max_rate, multiplier: 1e-3 }
- sub: &ctas
  - { name: Blocks/us, suffix: .sum.per_second, multiplier: 1e-6 }
  - { name: Blocks, suffix: .sum }
- sub: &ctas_sm
  - *throughput
  - { name: Avg Blocks/SM, suffix: .avg.per_cycle_elapsed }
- sub: &ctas_sm_tpc
  - *throughput
  - { name: Avg Blocks/SM, suffix: .avg.per_cycle_elapsed, multiplier: 0.5 }
- sub: &cgas
  - { name: Clusters, suffix: .sum }
- sub: &cycles
  - { name: Cycles, suffix: .sum }
- sub: &throughput_and_cycles
  - *throughput
  - *cycles
- sub: &cycles_ratio
  - { name: Cycles, suffix: .ratio, maxValueSuffix: .max_rate }
- sub: &dispatches
  - { name: Dispatches, suffix: .sum }
- sub: &hertz
  - { name: MHz, suffix: .avg.per_second, multiplier: 1.e-6 }
  - { name: Cycles, suffix: .avg }
- sub: &inst_ratio
  - { name: Threads/Warp, suffix: .ratio, maxValueSuffix: .max_rate }
  - { name: Coherence, suffix: .pct }
- sub: &ratio
  - { name: Ratio %, suffix: .pct, maxValueSuffix: .max_rate }
- sub: &registers
  - { name: Occupancy %, suffix: .avg.pct_of_peak_sustained_elapsed }
  - { name: Registers/SM, suffix: .avg.per_cycle_elapsed }
- sub: &registers_tpc
  - { name: Occupancy %, suffix: .avg.pct_of_peak_sustained_elapsed }
  - { name: Registers/SM, suffix: .avg.per_cycle_elapsed, multiplier: 0.5 }
- sub: &registers_ratio
  - { name: Registers, suffix: .ratio }
- sub: &warps
  - { name: Warps/SM, suffix: .avg.per_cycle_elapsed, maxValueSuffix: .avg.peak_sustained }
  - { name: Occupancy %, suffix: .avg.pct_of_peak_sustained_elapsed  }
- sub: &warps_count
  - { name: Warps/us, suffix: .sum.per_second, multiplier: 1e-6 }
  - { name: Warps, suffix: .sum }
- sub: &warps_tpc
  - { name: Warps/SM, suffix: .avg.per_cycle_elapsed, maxValueSuffix: .avg.peak_sustained, multiplier: .5 }
  - { name: Occupancy %, suffix: .avg.pct_of_peak_sustained_elapsed  }
- sub: &warps_smsp
  - { name: Warps/SM, suffix: .avg.per_cycle_elapsed, maxValueSuffix: .avg.peak_sustained, multiplier: 4 }
  - { name: Occupancy %, suffix: .avg.pct_of_peak_sustained_elapsed  }

metricSets:
- name: Compute Triage Metrics for NVIDIA GR10x
  chips: [GR100]

  customMetricDefinitions:
  - TriageCompute.dram__throughput:
      description: DRAM Throughput (TriageCompute Configuration)
      throughput:
      - dram__sectors
  - TriageCompute.dram__write_throughput:
      description: DRAM Write Throughput (TriageCompute Configuration)
      throughput:
      - dram__sectors_op_write
  - TriageCompute.gcc__cache_bytes:
      counter:
        expr: 128 * gcc__cache_requests_type_instruction + 64 * gcc__cache_requests_type_constant
        sustainedRate: 128.0
      description: '# of bytes GCC cached'
  - TriageCompute.gcc__cache_bytes_lookup_miss:
      counter:
        expr: 128 * gcc__cache_requests_type_instruction_lookup_miss + 64 * gcc__cache_requests_type_constant_lookup_miss
        sustainedRate: 128.0
      description: '# of bytes GCC cached that missed'
  - TriageCompute.gr_total_ctas_launched_realtime:
      counter:
        expr: gr__ctas_launched_realtime + gr__workids_granted_as_ctas_realtime
        sustainedRate: 1.0
  - TriageCompute.l1tex__data_pipe_lsu_wavefronts:
      counter:
        expr: l1tex__data_pipe_lsu_wavefronts_mem_lgds + l1tex__data_pipe_lsu_wavefronts_mem_shared
        sustainedRate: 1.0
  - TriageCompute.l1tex__throughput:
      description: l1tex throughput for (TriageCompute Configuration)
      throughput:
      - TriageCompute.l1tex__data_pipe_lsu_wavefronts
      - l1tex__data_pipe_tc_wavefronts
      - l1tex__lsu_writeback_active
      - l1tex__m_l1tex2xbar_req_cycles_active_realtime
      - l1tex__m_xbar2l1tex_read_sectors_realtime
  - TriageCompute.lts__t_sectors_srcunit_ce_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_ce_realtime - lts__t_sectors_srcunit_ce_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit CE that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcunit_ce_realtime:
      description: proportion of L2 sector lookups from unit CE that hit
      ratio:
        expr: TriageCompute.lts__t_sectors_srcunit_ce_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_ce_realtime, RollupOp.sum
        maxRate: 1.0
  - TriageCompute.lts__t_sectors_srcunit_gcc_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_gcc_realtime - lts__t_sectors_srcunit_gcc_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit GCC that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcunit_gcc_realtime:
      description: proportion of L2 sector lookups from unit GCC that hit
      ratio:
        expr: TriageCompute.lts__t_sectors_srcunit_gcc_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_gcc_realtime, RollupOp.sum
        maxRate: 1.0
  - TriageCompute.lts__t_sectors_srcunit_tex_op_atom_realtime:
      counter:
        expr: lts__t_sectors_srcunit_tex_realtime - lts__t_sectors_srcunit_tex_op_read_realtime - lts__t_sectors_srcunit_tex_op_write_realtime
        sustainedRate: 1.0
  - TriageCompute.lts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime:
      counter:
        expr: TriageCompute.lts__t_sectors_srcunit_tex_op_atom_realtime - (lts__t_sectors_srcunit_tex_lookup_miss_realtime - lts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime - lts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime)
        sustainedRate: 1.0
      description: '# of LTS sectors from unit L1TEX for all atomics or reductions that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_atom_realtime:
      description: proportion of L2 sector lookups from unit L1TEX for atomics or reductions that hit
      ratio:
        expr: TriageCompute.lts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime, RollupOp.avg, TriageCompute.lts__t_sectors_srcunit_tex_op_atom_realtime, RollupOp.avg
        maxRate: 1.0
  - TriageCompute.lts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_tex_op_read_realtime - lts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime
        sustainedRate: 2.0
      description: '# of LTS sectors from unit L1TEX for all reads that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_read_realtime:
      description: proportion of L2 sector lookups from unit L1TEX for reads that hit
      ratio:
        expr: TriageCompute.lts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime, RollupOp.avg, lts__t_sectors_srcunit_tex_op_read_realtime, RollupOp.avg
        maxRate: 1.0
  - TriageCompute.lts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_tex_op_write_realtime - lts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit L1TEX for all writes that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_write_realtime:
      description: proportion of L2 sector lookups from unit L1TEX for writes that hit
      ratio:
        expr: TriageCompute.lts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime, RollupOp.avg, lts__t_sectors_srcunit_tex_op_write_realtime, RollupOp.avg
        maxRate: 1.0
  - TriageCompute.lts__throughput:
      description: LTS Throughput (TriageCompute Configuration)
      throughput:
      - lts__lts2xbar_cycles_active_realtime
      - lts__t_requests
      - lts__t_sectors_realtime
      - lts__xbar2lts_cycles_active
      - lts__d_sectors_fill_device
      - lts__ltcfabric2lts_cycles_active
  - TriageCompute.max_warps_per_sm:
      conversionFactor:
        dimunits: DimUnit.warps
        multiplier: 32.0
  - TriageCompute.pcie__throughput:
      description: PCIe Throughput TriageCompute Configuration
      throughput:
      - pcie__read_bytes
      - pcie__write_bytes
  - TriageCompute.sm__thread_inst_executed_pred_on:
      counter:
        expr: RerollUp(smsp__thread_inst_executed_pred_on, RollupOp.sum, HwUnit.sm)
        sustainedRate: 128.0
  - TriageCompute.sm__average_thread_inst_executed_pred_on_per_inst_executed_realtime:
      description: 'average # of active predicated-on threads per instruction executed'
      ratio:
        expr: TriageCompute.sm__thread_inst_executed_pred_on, RollupOp.avg, sm__inst_executed_realtime, RollupOp.avg
        maxRate: 32.0
  - TriageCompute.sm__thread_inst_executed:
      counter:
        expr: RerollUp(smsp__thread_inst_executed, RollupOp.sum, HwUnit.sm)
        sustainedRate: 128.0
  - TriageCompute.sm__throughput:
      description: SM Throughput (TriageCompute Configuration)
      throughput:
      - sm__inst_executed_pipe_uniform_realtime
      - sm__pipe_xu_cycles_active_realtime
      - sm__mem_tensor_cycles_active_realtime
      - sm__pipe_aluheavy_cycles_active_realtime
      - sm__inst_executed_realtime
      - sm__pipe_fmalite_cycles_active_realtime
      - sm__pipe_fmaheavy_cycles_active_realtime
      - sm__pipe_fp64_cycles_active_realtime
      - sm__pipe_tensor_cycles_active_realtime
  - TriageCompute.sm__warps_inactive_sm_idle:
      counter:
        expr: (sm__cycles_elapsed - sm__cycles_active) * TriageCompute.max_warps_per_sm
        sustainedRate: 32.0
      description: 'cumulative # of idle warp slots on idle SMs'
  - TriageCompute.syslts__t_sectors_aperture_peermem_realtime:
      counter:
        expr: syslts__t_sectors_realtime - syslts__t_sectors_aperture_sysmem_realtime
        sustainedRate: 1.0
      description: '# of SYSLTS sectors for the peer aperture'
  - TriageCompute.syslts__average_t_sector_aperture_peer:
      description: proportion of L2 sectors accessing peer memory
      ratio:
        expr: TriageCompute.syslts__t_sectors_aperture_peermem_realtime, RollupOp.avg, syslts__t_sectors_realtime, RollupOp.avg
        maxRate: 1.0
  - TriageCompute.syslts__average_t_sector_aperture_sysmem:
      description: proportion of L2 sectors accessing system memory
      ratio:
        expr: syslts__t_sectors_aperture_sysmem_realtime, RollupOp.avg, syslts__t_sectors_realtime, RollupOp.avg
        maxRate: 1.0
  - TriageCompute.syslts__t_sectors_srcunit_gcc_lookup_hit_realtime:
      counter:
        expr: syslts__t_sectors_srcunit_gcc_realtime - syslts__t_sectors_srcunit_gcc_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of SYSLTS sectors from unit GCC that hit'
  - TriageCompute.syslts__average_t_sector_hit_rate_srcunit_gcc_realtime:
      description: proportion of SYSL2 sector lookups from unit GCC that hit
      ratio:
        expr: TriageCompute.syslts__t_sectors_srcunit_gcc_lookup_hit_realtime, RollupOp.sum, syslts__t_sectors_srcunit_gcc_realtime, RollupOp.sum
        maxRate: 1.0
  - TriageCompute.syslts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime:
      counter:
        expr: syslts__t_sectors_srcunit_tex_op_read_realtime - syslts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of SYSLTS sectors from unit L1TEX for all reads that hit'
  - TriageCompute.syslts__average_t_sector_hit_rate_srcunit_tex_op_read_realtime:
      description: proportion of SYSL2 sector lookups from unit L1TEX for reads that hit
      ratio:
        expr: TriageCompute.syslts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime, RollupOp.avg, syslts__t_sectors_srcunit_tex_op_read_realtime, RollupOp.avg
        maxRate: 1.0
  - TriageCompute.syslts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime:
      counter:
        expr: syslts__t_sectors_srcunit_tex_op_write_realtime - syslts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of SYSLTS sectors from unit L1TEX for all writes that hit'
  - TriageCompute.syslts__average_t_sector_hit_rate_srcunit_tex_op_write_realtime:
      description: proportion of SYSL2 sector lookups from unit L1TEX for writes that hit
      ratio:
        expr: TriageCompute.syslts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime, RollupOp.avg, syslts__t_sectors_srcunit_tex_op_write_realtime, RollupOp.avg
        maxRate: 1.0
  - TriageCompute.syslts__t_sector_throughput_aperture_peer:
      description: throughput of L2 sectors accessing peer memory
      throughput:
      - TriageCompute.syslts__t_sectors_aperture_peermem_realtime
  - TriageCompute.syslts__t_sector_throughput_aperture_sysmem:
      description: throughput of L2 sectors accessing system memory
      throughput:
      - syslts__t_sectors_aperture_sysmem_realtime
  - TriageCompute.syslts__t_sectors_srcunit_tex_op_atom_realtime:
      counter:
        expr: syslts__t_sectors_srcunit_tex_realtime - syslts__t_sectors_srcunit_tex_op_read_realtime - syslts__t_sectors_srcunit_tex_op_write_realtime
        sustainedRate: 1.0
  - TriageCompute.syslts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime:
      counter:
        expr: (TriageCompute.syslts__t_sectors_srcunit_tex_op_atom_realtime) - (syslts__t_sectors_srcunit_tex_lookup_miss_realtime - syslts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime - syslts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime)
        sustainedRate: 1.0
      description: '# of SYSLTS sectors from unit L1TEX for all atomics or reductions that hit'
  - TriageCompute.syslts__throughput:
      description: SYSLTS Throughput (TriageCompute Configuration)
      throughput:
      - syslts__syslts2xbar_cycles_active
      - syslts__t_requests
      - syslts__t_sectors_realtime
      - syslts__xbar2syslts_cycles_active
  - TriageCompute.tpc__average_bytes_mem_untagged_data_shared_allocated_compute_per_cta_realtime:
      description: average shared memory per CTA
      ratio:
        expr: tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_realtime, RollupOp.avg, tpc__ctas_active_realtime, RollupOp.avg
        maxRate: 328*2*1024
  - TriageCompute.tpc__average_cta_latency_realtime:
      description: average CTA duration (cycles)
      ratio:
        expr: tpc__ctas_active_realtime, RollupOp.sum, gr__ctas_launched_realtime, RollupOp.sum
        maxRate: 1.0
  - TriageCompute.tpc__average_cta_user_latency_realtime:
      description: average user CTA duration (cycles)
      ratio:
        expr: tpc__ctas_active_realtime, RollupOp.sum, TriageCompute.gr_total_ctas_launched_realtime, RollupOp.sum
        maxRate: 1.0
  - TriageCompute.tpc__threads_active_shader_cs_realtime:
      counter:
        expr: tpc__warps_active_shader_cs_realtime * 32
        sustainedRate: 2048.0
  - TriageCompute.tpc__average_registers_per_thread_shader_cs_realtime:
      description: 'average # of registers per thread, for CS warps'
      ratio:
        expr: tpc__sm_rf_registers_allocated_shader_cs_realtime, RollupOp.avg, TriageCompute.tpc__threads_active_shader_cs_realtime, RollupOp.avg
        maxRate: 256.0
  - TriageCompute.tpc__average_sharedmem_bytes_per_cta_realtime:
      description: average shared memory per CTA
      ratio:
        expr: tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_realtime, RollupOp.avg, tpc__ctas_active_realtime, RollupOp.avg
        maxRate: 671744.0
  - TriageCompute.tpc__average_warp_latency_shader_cs_realtime:
      description: average CS warp duration (cycles)
      ratio:
        expr: tpc__warps_active_shader_cs_realtime, RollupOp.avg, tpc__warps_launched_shader_cs, RollupOp.avg
        maxRate: 1.0
  - TriageCompute.tpc__l1tex_sram_bytes_mem_untagged_data_shared_unallocated_compute_realtime:
      counter:
        expr: tpc__l1tex_sram_bytes_mem_untagged_realtime - tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_realtime
        sustainedRate: 328*2*1024
      description: 'cumulative # of shared memory bytes unallocated for compute'
  - TriageCompute.ComputeTriage_TPC.tpc__warps_active:
      counter:
        expr: tpc__warps_active_shader_cs_realtime
        sustainedRate: 64.0
      description: 'cumulative # of warps in flight'
  - TriageCompute.ComputeTriage_TPC.tpc__l1tex_average_cache_bytes_per_warp:
      description: average cache bytes per warp
      ratio:
        expr: tpc__l1tex_sram_bytes_mem_tagged_realtime, RollupOp.avg, TriageCompute.ComputeTriage_TPC.tpc__warps_active, RollupOp.avg
        maxRate: 336*1024
  - TriageCompute.ComputeTriage_TPC.sm__warps_inactive_sm_active:
      counter:
        expr: sm__cycles_active * TriageCompute.max_warps_per_sm - RollDown(TriageCompute.ComputeTriage_TPC.tpc__warps_active, HwUnit.sm)
        sustainedRate: 32.0
      description: 'cumulative # of idle warp slots on active SMs'
  - nsys.max_warps_per_tpc:
      conversionFactor:
        dimunits: DimUnit.warps
        multiplier: 64.0
  - nsys.gr__compute_cycles_active:
      counter:
        expr: FMax(gr__compute_cycles_active_queue_sync, gr__compute_cycles_active_queue_async)
        sustainedRate: 1.0
      description: '# of cycles with compute in flight'
  - nsys.tpc__warps_inactive_sm_active:
      counter:
        expr: RerollUp(sm__cycles_active, RollupOp.avg, HwUnit.tpc) * nsys.max_warps_per_tpc - TriageCompute.ComputeTriage_TPC.tpc__warps_active
        sustainedRate: 64.0
      description: 'cumulative # of idle warp slots on active SMs'
  - nsys.syslts__average_t_sector_hit_rate_aperture_peermem:
      description: proportion of SysL2 peermem sector lookups that hit
      ratio:
        expr: syslts__t_sectors_aperture_peermem_lookup_hit_realtime, RollupOp.sum, TriageCompute.syslts__t_sectors_aperture_peermem_realtime, RollupOp.sum
        maxRate: 1.0
  - nsys.syslts__average_t_sector_hit_rate_aperture_sysmem:
      description: proportion of SysL2 sysmem sector lookups that hit
      ratio:
        expr: syslts__t_sectors_aperture_sysmem_lookup_hit_realtime, RollupOp.sum, syslts__t_sectors_aperture_sysmem_realtime, RollupOp.sum
        maxRate: 1.0
  - nsys.sm__pipe_fma_cycles_active_realtime:
      counter:
        expr: sm__pipe_fmalite_cycles_active_realtime + sm__pipe_fmaheavy_cycles_active_realtime
  - nsys.nvltx__bytes_data_protocol:
      counter:
        expr: nvltx__bytes - nvltx__bytes_data_user
        sustainedRate: 1.0
      description: '# of bytes of NVLTX overhead data, at 32B granularity'
  - nsys.nvlrx__bytes_data_protocol:
      counter:
        expr: nvlrx__bytes - nvlrx__bytes_data_user
        sustainedRate: 1.0
      description: '# of bytes of NVLRX overhead data, at 32B granularity'
  - TriageCompute.syslts__average_t_sector_hit_rate_srcunit_tex_op_atom_realtime:
      description: proportion of SYSL2 sector lookups from unit L1TEX for atomics or reductions that hit
      ratio:
        expr: TriageCompute.syslts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime, RollupOp.avg, TriageCompute.syslts__t_sectors_srcunit_tex_op_atom_realtime, RollupOp.avg
        maxRate: 1.0

  metrics:
  - { name: "Compute Pipe Active", id: nsys.gr__compute_cycles_active, subMetrics: *throughput_and_cycles, color: orange }
  - { name: "PCIe Throughput", id: TriageCompute.pcie__throughput, subMetrics: *throughput, color: "#3577F3", shortName: PCIe }
  - { name: "DRAM Total Bandwidth", id: dram__sectors, subMetrics: *bandwidth_sectors, color: "#CC6666" }
  - { name: "SysL2 Throughput", id: TriageCompute.syslts__throughput, subMetrics: *throughput, color: cyan, shortName: SysL2 }
  - { name: "VidL2 Throughput", id: TriageCompute.lts__throughput, subMetrics: *throughput, color: "#00AEDB", shortName: VidL2 }
  - { name: "SM Throughput", id: TriageCompute.sm__throughput, subMetrics: *throughput, color: "#D100EE", shortName: SM }
  - { name: "L1TEX Throughput", id: TriageCompute.l1tex__throughput, subMetrics: *throughput, color: "#B6D900", shortName: L1TEX }
  - { name: "PCIe RX Bandwidth", id: pcie__read_bytes, subMetrics: *bandwidth, color: khaki }
  - { name: "PCIe TX Bandwidth", id: pcie__write_bytes, subMetrics: *bandwidth, color: darkkhaki }
  - { name: "NVLink RX Bandwidth", id: nvlrx__bytes, subMetrics: *bandwidth, color: dodgerblue }
  - { name: "NVLink TX Bandwidth", id: nvltx__bytes, subMetrics: *bandwidth, color: indianred }
