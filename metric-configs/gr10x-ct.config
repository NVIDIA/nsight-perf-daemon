    - 0x70148cb431f9d807
    - 0xc83feae1569676cb
  - domain: gpu_sm_c
    counters:
    - 0x072dfe5865d3d982
    - 0x7f3ce2c9a5d9e8f8
    - 0x9ad8b1f11f309619
    - 0xff12a10aead6b65b
  - domain: gpu_tpc
    counters:
    - 0x06d1f77ff70d489d
    - 0x0f804245088573b2
    - 0x1126e14d39270675
    - 0x245d320dbf50e08c
    - 0x4066271ac67b23dc
    - 0x41d90b54064159ff
    - 0x452699787674fd29
    - 0x6284ea315d8e098c
    - 0xa88debd1894b75c9
    - 0xb0025dbffe9343a7
    - 0xd6239cc0795b1a76
    - 0xd6aa4eb67df61322
    - 0xd8a73abbc0419d77
    - 0xdff0418723f79c0e
    - 0xea255609c85d26f0

  metricGroups:
  - name: $root:Activity
    metrics:
    - Compute Pipe Active
    subMetrics: *throughput
    aggregationOp: max
  - name: $root:Memory
    metrics:
    - PCIe Throughput
    - DRAM Total Bandwidth
    subMetrics: *bandwidth
    aggregationOp: max
  - name: Top-Level Throughput
    description: "Identify which portion of the system is closest to reaching its %-of-peak.\nLow throughput usually indicates a latency-limited workload, or starvation.  First rule out starvation by checking workload launch sizes and warp occupancy.\nHigh throughput is usually good, but there may be speedup opportunities by offloading the highest unit, or reducing its workload.\n"
    metrics:
    - PCIe Throughput
    - DRAM Total Bandwidth
    - SysL2 Throughput
    - VidL2 Throughput
    - SM Throughput
    - L1TEX Throughput
    subMetrics: *throughput
    aggregationOp: max
  - name: PCIe Bandwidth
    description: "Total PCIe bandwidth.\nPCIe is a full-duplex interface.  The RX and TX hard-wires can transfer in parallel.\nGPU Metrics overhead will show up here as background TX traffic.\n"
    metrics:
    - PCIe RX Bandwidth
    - PCIe TX Bandwidth
    subMetrics: *bandwidth
    aggregationOp: max
  - name: NVLink Bandwidth
    description: "Total NVLink bandwidth.\nNVLink is a full-duplex interface.  The RX and TX hard-wires can transfer in parallel.\n"
    metrics:
    - NVLink RX Bandwidth
    - NVLink TX Bandwidth
    subMetrics: *bandwidth
    aggregationOp: max
  - name: DRAM Bandwidth
    description: "Total onboard DRAM bandwidth.\nDRAM is a half-duplex interface.  Read and write occur in alternation.\n"
    metrics:
    - DRAM Read Bandwidth
    - DRAM Write Bandwidth
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: SysL2 Throughput
    description: "Observe the SysL2 cache's %-of-peak, and find its top limiters.\nThe SysL2 cache serves SysMem and PeerMem aperture accesses.\n"
    metrics:
    - SysL2 Request Active
    - SysL2-to-XBAR Active
    - XBAR-to-SysL2 Active
    - SysL2 Request Stage Active
    - SysL2 Atomic Stage Active
    subMetrics: *throughput
    aggregationOp: max
  - name: VidL2 Throughput
    description: "Observe the VidL2 cache's %-of-peak, and find its top limiters.\nThe VidL2 cache serves VidMem aperture accesses, and is connected to the onboard DRAM.\n"
    metrics:
    - VidL2 Sectors
    - VidL2-to-XBAR Active
    - XBAR-to-VidL2 Active
    - VidL2 Request Active
    - VidL2 Atomic Stage Active
    subMetrics: *throughput
    aggregationOp: max
  - name: L1TEX Throughput
    description: "Observe the L1TEX cache's %-of-peak, and find its top limiters.\nIf achieved bandwidth is low, but throughput is high, it may imply an inefficient access pattern (lacking coalescing, shared memory bank conflicts, etc.).\n\nThe L1TEX cache has two parallel pipelines:\n• LSU : local, global, distributed shared, shared memory, shuffle/redux/match/S2R\n• TC : Tensor Core / UTCMMA wavefronts\n\nCache Fills and XBAR traffic contend with LSU and TC.\n\nThe 336KB of on-chip RAM per SM is composed of 3 SRAMs (128KB + 128KB + 80KB) represented by 2 virtual subbanks (128KB + 208KB).\nShared memory can span 0–328KB, while tagged cache memory occupies the upper portion of the RAM depending on configuration; in the 328KB SHM mode, only 8KB of tagged L1 remains.\n"
    metrics:
    - L1TEX LSU Data-Stage Throughput
    - L1TEX LSU Writeback-Stage Throughput
    - L1TEX TC Data-Stage Throughput
    - XBAR-to-L1TEX Read Sectors
    - XBAR-to-L1TEX DSMEM Read Sectors
    - L1TEX-to-XBAR Requests Active
    - L1TEX-to-XBAR DSMEM Requests Active
    - L1TEX-to-XBAR TMA Requests Active
    subMetrics: *throughput
    aggregationOp: max
  - name: SM Throughput
    description: "Observe the shader cores' %-of-peak for instruction issue and math performance.\n• Issue Stage covers all operations.\n• ALUHeavy covers INT32, except for integer multiply and dot-product.\n• FMA covers integer multiply, dot-product, scalar and packed FP16/FP32 ops.\n• XU is the special function unit, for reciprocals, square-roots, and transcendentals.\n• Tensor performs CUDA HMMA, DMMA, IMMA.\n• Uniform performs warp-level scalar operations.\n"
    metrics:
    - SM Issue Stage Throughput
    - SM ALU Pipe Throughput
    - SM FMA Pipe Throughput
    - SM XU Pipe Throughput
    - SM Tensor Pipe Throughput
    - SM Tensor Pipe Throughput (HMMA)
    - SM Tensor Pipe Throughput (DMMA)
    - SM Uniform Pipe Throughput
    subMetrics: *throughput
    aggregationOp: max
  - name: SM Memory Bandwidth
    description: "Observe the bandwidth from the SM to each shader memory space.\nEvery item in this row is generated (directly or indirectly) by shaders or CUDA kernels.\nThe metrics in this row are overlaid to show the absolute magnitude; however, this disregards pipeline or bus sharing.  See additional L1TEX Throughput and Bandwidth rows to understand those types of limiters.\n"
    metrics:
    - L1TEX Tag-Stage Bandwidth
    - L1TEX LSU Data-Stage Throughput
    - L1TEX TC Data-Stage Throughput
    subMetrics: *bandwidth
    aggregationOp: max
  - name: L1TEX LSU Throughput
    description: "Observe the Load/Store Unit's %-of-peak, and find its top limiters.\nIf LSU Data > LSU Writeback, it's likely poor address coalescing (local / global), or high bank conflicts (shared).\nIf LSU Writeback > LSU Data, it's likely due to 64-bit or 128-bit uniform loads.\n"
    metrics:
    - L1TEX LSU Data-Stage Throughput
    - L1TEX LSU Writeback-Stage Throughput
    subMetrics: *throughput
    aggregationOp: max
  - name: L1TEX LSU Throughput per Memory Space
    description: "Determine the main contributor to high LSU throughput.\nLocal memory is used by indexed per-thread arrays, and compiler spills when out-of-registers.\nGlobal memory corresponds to certain types of buffers, like byte addressed buffers.\nShared memory is groupshared in HLSL, or 'shared\" in GLSL.\nWave Intrinsics include shuffles and warp-level reductions.\n"
    metrics:
    - L1TEX Local+Global Data-Stage Throughput
    - L1TEX Shared+Attribute Data-Stage Throughput
    subMetrics: *throughput
    aggregationOp: sum
  - name: Local/Global Bandwidth
    description: "Bandwidth requests to \"tagged\" memory spaces that reside in main memory.\nIncludes local and global memory accesses.\nDoes not include shared memory.\n"
    metrics:
    - L1TEX Tag-Stage Bandwidth
    - L1TEX Tag-Stage Bandwidth (miss)
    - VidL2 Total from L1TEX
    - VidL2 Misses from L1TEX
    - SysL2 Bandwidth from L1TEX
    - SysL2 Misses from L1TEX
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: L1TEX Tag-Stage Bandwidth per Hit/Miss
    description: "Bandwidth requests to \"tagged\" data memory spaces that reside in main memory, decomposed into hit and miss bandwidth.\nTagged data memory includes local and global memory accesses.\nRequests to untagged memory always count as misses.\n"
    metrics:
    - L1TEX Tag-Stage Bandwidth (hit)
    - L1TEX Tag-Stage Bandwidth (miss)
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: L1TEX Sector Hit-Rate
    description: "This row shows the aggregate hit-rate.  Note that atomics always miss in L1TEX (0% hit-rate), and are therefore not shown here.\n"
    metrics:
    - L1TEX Hit-Rate
    subMetrics: *ratio
    aggregationOp: max
  - name: L2 Sector Hit-Rate from L1TEX
    description: "If the hit-rates in this row are low, it means data accesses are missing in both the L1TEX cache and the L2 cache.  These accesses will pay the full latency penalty of a main memory access (to system memory or video memory).\n"
    metrics:
    - VidL2 Sector Hit-Rate from L1TEX Reads
    - VidL2 Sector Hit-Rate from L1TEX Writes
    - VidL2 Sector Hit-Rate from L1TEX Atomics
    - SysL2 Sector Hit-Rate from L1TEX Reads
    - SysL2 Sector Hit-Rate from L1TEX Writes
    - SysL2 Sector Hit-Rate from L1TEX Atomics
    subMetrics: *ratio
    aggregationOp: max
  - name: Constant Memory Bandwidth
    description: "See also: the GCC Bandwidth row for the total GCC and L2 bandwidth impact.\n"
    metrics:
    - GCC Constant Bandwidth
    - GCC Constant Miss Bandwidth
    - GCC Constant Tag Hit Bandwidth
    subMetrics: *bandwidth
    aggregationOp: max
  - name: Constant Cache Hit-Rates
    metrics:
    - GCC Constant Hit-Rate
    subMetrics: *ratio
    aggregationOp: max
  - name: Instruction Memory Bandwidth
    description: "See also: the GCC Bandwidth row for the total GCC and L2 bandwidth impact.\n"
    metrics:
    - GCC Inst Bandwidth
    - GCC Inst Miss Bandwidth
    - GCC Instruction Tag Hit Bandwidth
    subMetrics: *bandwidth
    aggregationOp: max
  - name: Instruction Cache Hit-Rates
    metrics:
    - GCC Inst Hit-Rate
    subMetrics: *ratio
    aggregationOp: max
  - name: GCC Bandwidth
    description: "The GCC is a mid-level cache for constant and instruction descriptor memory.  It sits between the corresponding L1 caches (DCC, IDC, ICC, TSL1) and the L2 cache(s).\nThis row shows the overall bandwidth for these memory spaces, and the flow through the cache hierarchy.\n"
    metrics:
    - GCC Bandwidth
    - GCC Miss Bandwidth
    - VidL2 Bandwidth from GCC
    - VidL2 Sector Misses from GCC
    - SysL2 Bandwidth from GCC
    - SysL2 Sector Misses from GCC
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: GCC Bandwidth per Type
    description: "The GCC Constant Cache's bandwidth is proportional to miss-traffic from various L1 caches in the SMs.\n[128-bytes / cycle] Instruction requests come from the SM L1I$, aka ICC.\n[  64-bytes / cycle] Constant requests come from the DCC (scalar constant cache) or IDC (indexed constant cache).\n"
    metrics:
    - GCC Inst Bandwidth
    - GCC Constant Bandwidth
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: GCC Hit-Rates
    description: "Observe the hit-rate of each memory space served by the GCC cache:\nIf low instruction hit-rate: consider reducing loop unrolling or force-no-inline.\nIf low constant hit-rate: consider compacting data into 64B or 256B aligned regions (cache & prefetch-friendly), and reducing indexed constant loads.\n"
    metrics:
    - GCC Inst Hit-Rate
    - GCC Constant Hit-Rate
    subMetrics: *ratio
    aggregationOp: max
  - name: GCC Tag-Stage Miss-Bandwidth per Type
    description: "The approximate miss bandwidth from GCC to L2.\nThis row shows tag misses, not true misses.\n"
    metrics:
    - GCC Inst Miss Bandwidth
    - GCC Constant Miss Bandwidth
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: Compute Engine
    description: "Indicates whether a compute dispatch is in the pipeline.\nA dispatch that was started, but hasn't yet launched a thread block, will be counted here.\nDispatches may be queued for a long time before launching their first thread block.\n"
    metrics:
    - Compute Pipe Active
    subMetrics: *throughput_and_cycles
    aggregationOp: max
  - name: Thread Blocks Launched
    description: "Observe thread blocks launched from CWD or preloaded thread blocks received new WorkID.\n"
    metrics:
    - Thread Blocks Launched from CWD
    - WorkIDs Granted as Thread Blocks
    subMetrics: *ctas
    aggregationOp: sum
  - name: GR Kernel Launch
    description: "Observe the number of compute dispatches sent to GR.\n"
    metrics:
    - Kernel Launched
    subMetrics: *dispatches
    aggregationOp: max
  - name: GR Context Switches
    description: "Observe the cycles where GR performed a context switch.\n"
    metrics:
    - GR Context Switch
    subMetrics: *cycles
    aggregationOp: max
  - name: Sync Compute Q Engine Activity
    description: "Observe when the Sync Q is active processing a command.\n"
    metrics:
    - Sync Compute in Flight
    subMetrics: *throughput_and_cycles
    aggregationOp: max
  - name: Sync Compute Q Semaphore Releases
    description: "Release of a hardware semaphore value in memory.\n"
    metrics:
    - Sync Queue Semaphore Releases
    subMetrics: *counts
    aggregationOp: max
  - name: Sync Compute Q Waiting
    description: "Observe when the Sync Q is waiting on work completion at the FrontEnd stage.  While a queue is waiting in this way, it will not issue any further commands to GPU engines.\n"
    metrics:
    - Sync Wait For Idle
    subMetrics: *throughput_and_cycles
    aggregationOp: max
  - name: Sync Compute Q GPFIFO Idle
    description: "Observe when the Sync Q is idle due to a lack of pending commands.\n"
    metrics:
    - Sync GPFIFO Idle
    subMetrics: *throughput_and_cycles
    aggregationOp: max
  - name: Async Compute Q Engine Activity
    description: "Observe when the Async Q is active processing a command.\n"
    metrics:
    - Async Compute in Flight
    subMetrics: *throughput_and_cycles
    aggregationOp: max
  - name: Async Compute Q Semaphore Releases
    description: "Release of a hardware semaphore value in memory.\n"
    metrics:
    - Async Compute Q Semaphore Releases
    subMetrics: *counts
    aggregationOp: max
  - name: Async Compute Q Waiting
    description: "Observe when any Async Compute Q is waiting on work completion at the FrontEnd stage.  While a queue is waiting in this way, it will not issue any further commands to GPU engines.\n"
    metrics:
    - Async Compute Q Wait For Idle
    subMetrics: *throughput_and_cycles
    aggregationOp: max
  - name: System Memory
    description: "Bandwidth to the system memory aperture, at the SysL2 Request stage, SysL2 Miss stage, and at the PCIe connection.\n"
    metrics:
    - SysL2 Total Memory Bandwidth
    - SysL2 Miss Bandwidth
    - PCIe RX Bandwidth
    - PCIe TX Bandwidth
    subMetrics: *bandwidth
    aggregationOp: max
  - name: NVLink RX Bandwidth Breakdown
    description: "Inbound NVLink bandwidth.\nResponses User/Protocol Data metrics indicate when GPU is pulling data from remote memory.\n"
    metrics:
    - NVLink RX User Data
    - NVLink RX Protocol Data
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: NVLink TX Bandwidth Breakdown
    description: "Outbound NVLink bandwidth.\nResponses User/Protocol Data metrics indicate when a remote GPU is reading local data.\n"
    metrics:
    - NVLink TX User Data
    - NVLink TX Protocol Data
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: SysL2 Bandwidth per Destination
    description: "Bandwidth requests to the GPU's SysL2 cache per memory aperture.\nIf a large amount of traffic is going to system memory, consider allocating DRAM buffers, and separately copying results in/out.\n"
    metrics:
    - SysL2-to-SysMem Bandwidth
    - SysL2-to-PeerMem Bandwidth
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: SysL2 Bandwidth per Source Unit
    description: "Bandwidth requests to the GPU's SysL2 cache, broken down by source unit.\nThis row makes it easy to determine which units are missing in their L1 caches, or otherwise generating a large amount of memory traffic.\n"
    metrics:
    - SysL2 Bandwidth from L1TEX
    - SysL2 Bandwidth from GCC
    - SysL2 Bandwidth from CE
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: SysL2 Sector Hit-Rate (Total)
    description: "Use this row to diagnose latency-limited workloads.\n"
    metrics:
    - SysL2 Sector Hit-Rate
    subMetrics: *ratio
    aggregationOp: max
  - name: SysL2 Sector Hit-Rate per Destination
    metrics:
    - SysL2 Sector Hit Rate from PeerMem
    - SysL2 Sector Hit Rate from SysMem
    subMetrics: *ratio
    aggregationOp: sum
  - name: SysL2 Sector Hit-Rate per Source Unit
    metrics:
    - SysL2 Sector Hit-Rate from L1TEX
    - SysL2 Sector Hit-Rate from GCC
    subMetrics: *ratio
    aggregationOp: max
  - name: SysLRC Throughput
    description: "Indicates whether SysLRC is successfully merging read traffic from system memory.\nWhen multiple GPC/L1TEX read requests target the same cache line within a window, LRC can coalesce them and multicast the response back through XBAR instead of sending duplicate SysL2 traffic.\n• High Coalesced, low Fragmented → multicast/coalescing is working, reducing return-path traffic pressure.\n• Low Coalesced, high Fragmented → reads are mostly uncoalesced, so system memory traffic is less efficient.\n• Coalesced XBAR-to-GPC much larger than SysLRC-to-XBAR → strong coalescing payoff / fanout to multiple GPC consumers.\n"
    metrics:
    - SysLRC-to-XBAR Coalesced Reads
    - SysLRC XBAR-to-GPC Coalesced Reads
    - SysL2-to-SysLRC Fragmented Reads
    subMetrics: *bandwidth
    aggregationOp: max
  - name: Video Memory
    description: "Bandwidth to the video memory aperture, at the VidL2 Request, VidL2 Miss, and onboard DRAM stages.\nDRAM is a half-duplex interface.  Read and write occur in alternation.\n"
    metrics:
    - DRAM Total Bandwidth
    - VidL2 Miss Bandwidth
    - VidL2 Sectors
    subMetrics: *bandwidth
    aggregationOp: max
  - name: VidL2 Bandwidth per Source Unit
    description: "Bandwidth requests to the GPU's VidL2 cache, broken down by source unit.\nThis row makes it easy to determine which units are missing in their L1 caches, or otherwise generating a large amount of memory traffic.\n"
    metrics:
    - VidL2 Total from L1TEX
    - VidL2 Bandwidth from GCC
    - VidL2 Bandwidth from CE
    subMetrics: *bandwidth
    aggregationOp: sum
  - name: VidL2 Sector Hit-Rate (Total)
    description: "Use this row to diagnose latency-limited workloads.\n"
    metrics:
    - VidL2 Sector Hit-Rate
    subMetrics: *ratio
    aggregationOp: max
  - name: VidL2 Sector Hit-Rate per Source Unit
    description: "Use this row to diagnose latency-limited workloads.\n"
    metrics:
    - VidL2 Sector Hit-Rate from L1TEX
    - VidL2 Sector Hit-Rate from GCC
    - VidL2 Sector Hit-Rate from CE
    subMetrics: *ratio
    aggregationOp: max
  - name: VidLRC Throughput
    description: "Indicates whether VidLRC is successfully merging read traffic from video memory.\nWhen multiple GPC/L1TEX read requests target the same cache line within a window, LRC can coalesce them and multicast the response back through XBAR instead of sending duplicate VidL2 traffic.\n• High Coalesced, low Fragmented → VidLRC coalescing/multicast is working, reducing VidL2 return-path traffic pressure.\n• Low Coalesced, high Fragmented → reads are mostly uncoalesced, so video memory traffic is less efficient.\n• Coalesced XBAR-to-GPC much larger than VidLRC-to-XBAR → strong coalescing payoff / fanout to multiple GPC consumers.\n"
    metrics:
    - VidLRC-to-XBAR Coalesced Reads
    - VidLRC XBAR-to-GPC Coalesced Reads
    subMetrics: *bandwidth
    aggregationOp: max
  - name: Warp Latency
    description: "Warp Latency estimates the average lifespan of a warp (in cycles), over a span of time in which the SMs were active. \nThus, it appears as a constant value across each compute execution region.  It's an absolute measure of kernel performance, and is comparable from run-to-run.\nThe boundaries of each compute execution region are determined by periods of no or low kernel activity.\n"
    metrics:
    - Compute Warp Latency
    subMetrics: *cycles_ratio
    aggregationOp: max
  - name: SM Warps Launched
    description: "Indicates when compute warps were launched onto SMs.\n"
    metrics:
    - Compute Warps Launched
    subMetrics: *warps_count
    aggregationOp: max
  - name: SM Warp Stalls
    description: "Indicates the % of warps that are waiting on each latency reason.\n• Short scoreboard : L1TEX operations (local, global)\n• Long scoreboard : MIO operations other than (local, global)\n"
    metrics:
    - Stalled on Short Scoreboard
    - Stalled on Long Scoreboard
    subMetrics: *warps
    aggregationOp: sum
  - name: Active Threads per Warp
    description: "Low % predicated-on threads implies poor math pipe utilization.\n"
    metrics:
    - Predicated-on Active Threads per Warp
    subMetrics: *inst_ratio
    aggregationOp: max
  - name: SM Tensor Pipe Instructions per Family
    description: "Observe which type of output Tensor Instructions generate.\n"
    metrics:
    - SM Tensor Pipe Throughput (DMMA)
    - SM Tensor Pipe Throughput (HMMA)
    subMetrics: *throughput_and_cycles
    aggregationOp: sum
  - name: SM Tensor Memory Throughput
    metrics:
    - SM Tensor Memory Throughtput
    subMetrics: *throughput
    aggregationOp: max
  - name: SM Tensor Memory Allocation
    metrics:
    - SM Thread Block Tensor Memory
    subMetrics: *avg_bytes
    aggregationOp: max
  - name: SM Thread Block Average Shared Memory
    metrics:
    - SM Avg Thread Block Shared Memory
    subMetrics: *capacity
    aggregationOp: max
  - name: SM Registers per Thread
    metrics:
    - SM Avg Registers per Thread
    subMetrics: *registers_ratio
    aggregationOp: max
  - name: Thread Block Clusters
    description: "Observe Thread Block Clusters activity.\nLarger clusters reduce placement flexibility and often hurt concurrency/throughput.\n• Low Launched and low Active indicate launch/dispatch starvation.\n• High Launched and low Active indicate short-lived clusters or weak residency.\n• High Active and low Completed indicates long-lived or stalled clusters; look downstream at SM, memory, barriers, DSMEM.\n"
    metrics:
    - Thread Block Clusters Launched
    - Thread Block Clusters Active
    - Thread Block Clusters Completed
    subMetrics: *cgas
    aggregationOp: max
  - name: SM Warp Occupancy
    description: "The number of occupied warp slots, on average.\nDo not worry about warp occupancy unless SM Instruction Throughput is low.  Increasing warp occupancy is one way to improve the issue rate, but there are other ways as well (increasing intra-warp arithmetic intensity, reducing long latency operations).\nFewer than 4 warps on an SM is a starvation condition; launch bigger workloads.\nHigher is not always better.  16 warps/SM is enough to fully hide math pipe latency.\nUnused slots on Active SMs usually imply that an occupancy limiter was reached.\n"
    metrics:
    - SM Warps Active
    - Unallocated Warps in Active SMs
    subMetrics: *warps
    aggregationOp: sum
  - name: SM Register Occupancy
    description: "Each SM subpartition has a register file with 16K × 4Byte registers.\nEach warp allocates registers in chunks of 8 registers/thread × 32 threads/warp = 256 registers.\n"
    metrics:
    - CS Register Allocation
    subMetrics: *registers
    aggregationOp: sum
  - name: SM Thread Block Occupancy
    description: "At most, 16 thread blocks can be resident on a single SM at any given time.\n"
    metrics:
    - SM Thread Blocks Allocated
    subMetrics: *ctas_sm
    aggregationOp: max
  - name: L1TEX Data Occupancy
    description: "This row shows the partitioning of the 336KB on-chip memory per SM into shared memory and tagged cache memory.\n• When compute shaders are running, a partition is dynamically created for shared memory. When this partition is full, compute warp launches will stall.\n• The remainder - tagged cache - serves local and global memory accesses.\n"
    metrics:
    - SM Shared Memory Allocated
    - SM Shared Memory Unallocated
    - SM Tagged Memory
    subMetrics: *avg_bytes
    aggregationOp: sum
  - name: L1TEX Cache Bytes per Warp
    description: "Average cache bytes per warp\n"
    metrics:
    - SM Avg L1TEX Cache Bytes per Warp
    subMetrics: *capacity
    aggregationOp: max
  - name: Clock Frequencies
    description: "The GPU is divided into many clock domains; this row shows their frequencies over time.\n"
    metrics:
    - GPC Frequency
    - SYS Frequency
    - VidL2 Frequency
    - DRAM Frequency
    subMetrics: *hertz
    aggregationOp: max

  timelineViews:
  - name: Default
    rows:
    - metricGroup: $root:Activity
      heightScale: 0.5
    - metricGroup: $root:Memory
      heightScale: -0.5
    - metricGroup: Top-Level Throughput
      heightScale: 2
      children:
      - PCIe Bandwidth
      - NVLink Bandwidth
      - DRAM Bandwidth
      - SysL2 Throughput
      - VidL2 Throughput
      - L1TEX Throughput
      - SM Throughput
    - metricGroup: SM Memory Bandwidth
      children:
      - metricGroup: L1TEX Throughput
        children:
        - L1TEX LSU Throughput
        - L1TEX LSU Throughput per Memory Space
      - metricGroup: Local/Global Bandwidth
        children:
        - L1TEX Tag-Stage Bandwidth per Hit/Miss
        - L1TEX Sector Hit-Rate
        - L2 Sector Hit-Rate from L1TEX
      - metricGroup: Constant Memory Bandwidth
        children:
        - Constant Cache Hit-Rates
      - metricGroup: Instruction Memory Bandwidth
        children:
        - Instruction Cache Hit-Rates
      - metricGroup: GCC Bandwidth
        children:
        - GCC Bandwidth per Type
        - GCC Hit-Rates
        - GCC Tag-Stage Miss-Bandwidth per Type
    - metricGroup: Compute Engine
      children:
      - Thread Blocks Launched
      - GR Kernel Launch
      - GR Context Switches
    - metricGroup: Sync Compute Q Engine Activity
      children:
      - Sync Compute Q Semaphore Releases
      - Sync Compute Q Waiting
      - Sync Compute Q GPFIFO Idle
    - metricGroup: Async Compute Q Engine Activity
      children:
      - Async Compute Q Semaphore Releases
      - Async Compute Q Waiting
    - metricGroup: System Memory
      children:
      - metricGroup: NVLink Bandwidth
        children:
        - NVLink RX Bandwidth Breakdown
        - NVLink TX Bandwidth Breakdown
      - PCIe Bandwidth
      - SysL2 Bandwidth per Destination
      - SysL2 Bandwidth per Source Unit
      - SysL2 Sector Hit-Rate (Total)
      - SysL2 Sector Hit-Rate per Destination
      - SysL2 Sector Hit-Rate per Source Unit
      - SysL2 Throughput
      - SysLRC Throughput
    - metricGroup: Video Memory
      children:
      - DRAM Bandwidth
      - VidL2 Bandwidth per Source Unit
