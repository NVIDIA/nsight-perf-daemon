# NOTE: Metrics representing a superset of other metrics must be declared first
# if they appear in the same group (displayRows). Otherwise different metrics will
# dominate in the group row depending on zoom level if overlay display mode is used.
version: 7

subMetrics:
- sub: &counts
  - { name: Total, suffix: .sum }
- sub: &avg_cgas
  - { name: CGAs, suffix: .avg.per_cycle_elapsed }
- sub: &sum_cgas
  - { name: CGAs, suffix: .sum.per_cycle_elapsed }
- sub: &avg_blocks
  - { name: Blocks, suffix: .avg.per_cycle_elapsed }
- sub: &sum_blocks
  - { name: Blocks, suffix: .sum.per_cycle_elapsed }
- sub: &avg_sm_warps
  - { name: Warps per SM, suffix: .avg.per_cycle_elapsed, multiplier: 0.5 }
- sub: &sum_warps
  - { name: Warps, suffix: .sum.per_cycle_elapsed }
- sub: &bandwidth
  - { name: Bytes, suffix: .sum }
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 1.e-9 }
- sub: &bandwidth_no_peak
  - { name: GB/s,  suffix: .sum.per_second, multiplier: 1.e-9 }
  - { name: Bytes, suffix: .sum }
- sub: &throughput
  - { name: Throughput %, suffix: .avg.pct_of_peak_sustained_elapsed }
- sub: &ipc_sm_active
  - { name: IPC per SM, suffix: .avg.per_cycle_active }
- sub: &ipc_sm_elapsed
  - { name: IPC per SM, suffix: .avg.per_cycle_elapsed }
- sub: &pct_ratio
  - { name: Ratio %, suffix: .pct }
- sub: &hertz
  - { name: MHz, suffix: .avg.per_second, multiplier: 1.e-6 }

metricSets:
- name: Compute Triage Metrics for NVIDIA GB20y
  chips: [GB20B, GB20C]

  customMetricDefinitions:
  - TriageCompute.gr__ctas_launched_realtime:
      counter:
        expr: gr__ctas_launched_queue_sync_realtime + gr__ctas_launched_queue_async_realtime
        sustainedRate: 1.0
      description: '# of CTAs launched'
  - TriageCompute.gr_total_ctas_launched_realtime:
      counter:
        expr: TriageCompute.gr__ctas_launched_realtime + gr__workids_granted_as_ctas_realtime
        sustainedRate: 1.0
  - TriageCompute.lts__t_sectors_srcunit_ce_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_ce_realtime - lts__t_sectors_srcunit_ce_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit CE that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcunit_ce_realtime:
      ratio:
        expr: TriageCompute.lts__t_sectors_srcunit_ce_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_ce_realtime, RollupOp.sum
        maxRate: 1.0
      description: proportion of L2 sector lookups from unit CE that hit
  - TriageCompute.lts__t_sectors_srcunit_gcc_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_gcc_realtime - lts__t_sectors_srcunit_gcc_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit GCC that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcunit_gcc_realtime:
      ratio:
        expr: TriageCompute.lts__t_sectors_srcunit_gcc_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_gcc_realtime, RollupOp.sum
        maxRate: 1.0
      description: proportion of L2 sector lookups from unit GCC that hit
  - TriageCompute.lts__t_sectors_srcnode_gpc_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcnode_gpc_realtime - lts__t_sectors_srcnode_gpc_lookup_miss_realtime
        sustainedRate: 2.0
      description: '# of LTS sectors from node GPC that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcnode_gpc_realtime:
      ratio:
        expr: TriageCompute.lts__t_sectors_srcnode_gpc_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcnode_gpc_realtime, RollupOp.sum
        maxRate: 1.0
      description: proportion of L2 sector lookups from node GPC that hit
  - TriageCompute.lts__t_sectors_srcnode_hub_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcnode_hub_realtime - lts__t_sectors_srcnode_hub_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from node HUB that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcnode_hub_realtime:
      ratio:
        expr: TriageCompute.lts__t_sectors_srcnode_hub_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcnode_hub_realtime, RollupOp.sum
        maxRate: 1.0
      description: proportion of L2 sector lookups from node HUB that hit
  - TriageCompute.lts__t_sectors_srcunit_tex_op_atom_realtime:
      counter:
        expr: lts__t_sectors_srcunit_tex_realtime - lts__t_sectors_srcunit_tex_op_read_realtime - lts__t_sectors_srcunit_tex_op_write_realtime
  - TriageCompute.lts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime:
      counter:
        expr: TriageCompute.lts__t_sectors_srcunit_tex_op_atom_realtime - (lts__t_sectors_srcunit_tex_lookup_miss_realtime - lts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime - lts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime)
        sustainedRate: 1.0
      description: '# of LTS sectors from unit TEX for all atomics or reductions that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_atom_realtime:
      ratio:
        expr: TriageCompute.lts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime, RollupOp.avg, TriageCompute.lts__t_sectors_srcunit_tex_op_atom_realtime, RollupOp.avg
        maxRate: 1.0
      description: proportion of L2 sector lookups from unit TEX for atomics or reductions that hit
  - TriageCompute.lts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_tex_op_read_realtime - lts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime
        sustainedRate: 2.0
      description: '# of LTS sectors from unit TEX for all reads that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_read_realtime:
      ratio:
        expr: TriageCompute.lts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime, RollupOp.avg, lts__t_sectors_srcunit_tex_op_read_realtime, RollupOp.avg
        maxRate: 1.0
      description: proportion of L2 sector lookups from unit TEX for reads that hit
  - TriageCompute.lts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime:
      counter:
        expr: lts__t_sectors_srcunit_tex_op_write_realtime - lts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime
        sustainedRate: 1.0
      description: '# of LTS sectors from unit TEX for all writes that hit'
  - TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_write_realtime:
      ratio:
        expr: TriageCompute.lts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime, RollupOp.avg, lts__t_sectors_srcunit_tex_op_write_realtime, RollupOp.avg
        maxRate: 1.0
      description: proportion of L2 sector lookups from unit TEX for writes that hit
  - TriageCompute.lts__cbc_requests_type_comptag_realtime:
      counter:
        expr: lts__cbc_requests_type_comptag_lookup_hit_realtime + lts__cbc_requests_type_comptag_lookup_miss_or_hit_to_miss_realtime
        sustainedRate: 1.0
      description: '# of compressible requests handled by CBC'
  - TriageCompute.lts__throughput:
      throughput:
        - lts__t_sectors_realtime
        - lts__lts2xbar_cycles_active_realtime
        - lts__xbar2lts_cycles_active
        - lts__t_requests
        - lts__d_atomic_input_cycles_active
        - TriageCompute.lts__cbc_requests_type_comptag_realtime
        - lts__d_decomp_input_sectors_realtime
        - lts__d_sectors_fill_device
      description: LTS Throughput
  - TriageCompute.sm__throughput:
      throughput:
        - sm__inst_executed_realtime
        - sm__inst_executed_pipe_aluheavy_realtime
        - sm__pipe_fma_cycles_active_realtime
        - sm__pipe_fmaheavy_cycles_active_realtime
        - sm__inst_executed_pipe_xu_realtime
        - sm__inst_executed_pipe_uniform_realtime
        - sm__pipe_tensor_cycles_active_realtime
  - TriageCompute.tpc__warps_active:
      counter:
        expr: RerollUp(smsp__warps_active, RollupOp.avg, HwUnit.tpc)
        sustainedRate: 96.0
      description: 'cumulative # of warps in flight'

  metrics:
    - { name: "Average Warps Active per SM", id: TriageCompute.tpc__warps_active, subMetrics: *avg_sm_warps }
    - { name: "Total Warps Active", id: TriageCompute.tpc__warps_active, subMetrics: *sum_warps }
    - { name: "Total Blocks Launched", id: TriageCompute.gr__ctas_launched_realtime, subMetrics: *sum_blocks }
    - { name: "Average Blocks Active", id: tpc__ctas_active_realtime, subMetrics: *avg_blocks }
    - { name: "Total Blocks Active", id: tpc__ctas_active_realtime, subMetrics: *sum_blocks }
    - { name: "Total CGAs Launched", id: gpc__cgas_launched, subMetrics: *sum_cgas }
    - { name: "Average CGAs Active", id: gpc__cgas_active_realtime, subMetrics: *avg_cgas }
    - { name: "Total CGAs Active", id: gpc__cgas_active_realtime, subMetrics: *sum_cgas }
    - { name: "Executed IPC Active", id: sm__inst_executed_realtime, subMetrics: *ipc_sm_active }
    - { name: "Executed IPC Elapsed", id: sm__inst_executed_realtime, subMetrics: *ipc_sm_elapsed }
    - { name: "L1 Global LD Hit", id: l1tex__t_sectors_pipe_lsu_mem_global_op_ld_lookup_hit_realtime, subMetrics: *counts }
    - { name: "L1 Global ST Hit", id: l1tex__t_sectors_pipe_lsu_mem_global_op_st_lookup_hit_realtime, subMetrics: *counts }
    - { name: "L1 LDGSTS Hit", id: l1tex__t_sectors_pipe_lsu_mem_global_op_ldgsts_cache_access_lookup_hit_realtime, subMetrics: *counts }
    - { name: "L1 Local LD Hit", id: l1tex__t_sectors_pipe_lsu_mem_local_op_ld_lookup_hit_realtime, subMetrics: *counts }
    - { name: "L1 Local ST Hit", id: l1tex__t_sectors_pipe_lsu_mem_local_op_st_lookup_hit_realtime, subMetrics: *counts }
    - { name: "L1 Lookup Hit Throughput", id: l1tex__t_sectors_lookup_hit, subMetrics: *throughput }
    - { name: "L1 Lookup Miss", id: l1tex__t_sectors_lookup_miss, subMetrics: *counts }
    - { name: "L1 Lookup Miss Throughput", id: l1tex__t_sectors_lookup_miss, subMetrics: *throughput }
    - { name: "L1 Surface LD Hit", id: l1tex__t_sectors_pipe_tex_mem_surface_op_ld_lookup_hit_realtime, subMetrics: *counts }
    - { name: "L1 Surface ST Hit", id: l1tex__t_sectors_pipe_tex_mem_surface_op_st_lookup_hit_realtime, subMetrics: *counts }
    - { name: "L1 Texture LD Hit", id: l1tex__t_sectors_pipe_tex_mem_texture_op_ld_lookup_hit_realtime, subMetrics: *counts }
    - { name: "L1 Texture TEX Hit", id: l1tex__t_sectors_pipe_tex_mem_texture_op_tex_lookup_hit_realtime, subMetrics: *counts }
    - { name: "L1 Wavefronts Throughput", id: l1tex__data_pipe_lsu_wavefronts, subMetrics: *throughput }
    - { name: "L1 Wavefronts LGDS", id: l1tex__data_pipe_lsu_wavefronts_mem_lgds, subMetrics: *counts }
    - { name: "L1 Wavefronts Shared", id: l1tex__data_pipe_lsu_wavefronts_mem_shared, subMetrics: *counts }
    - { name: "L1 Wavefronts Shared Atom", id: l1tex__data_pipe_lsu_wavefronts_mem_shared_op_atom, subMetrics: *counts }
    - { name: "L1 Wavefronts Shared LD", id: l1tex__data_pipe_lsu_wavefronts_mem_shared_op_ld, subMetrics: *counts }
    - { name: "L1 Wavefronts Shared LDGSTS", id: l1tex__data_pipe_lsu_wavefronts_mem_shared_op_ldgsts, subMetrics: *counts }
    - { name: "L1 Wavefronts Shared Misc", id: l1tex__data_pipe_lsu_wavefronts_mem_shared_op_misc, subMetrics: *counts }
    - { name: "L1 Wavefronts Shared ST", id: l1tex__data_pipe_lsu_wavefronts_mem_shared_op_st, subMetrics: *counts }
    - { name: "L1 Wavefronts TEX", id: l1tex__data_pipe_tex_wavefronts, subMetrics: *counts }
    - { name: "L1 LSU Writeback Active", id: l1tex__lsu_writeback_active, subMetrics: *throughput }
    - { name: "L1 TEX Writeback Active", id: l1tex__tex_writeback_active, subMetrics: *throughput }
    - { name: "L2 to XBAR Active", id: lts__lts2xbar_cycles_active_realtime, subMetrics: *throughput }
    - { name: "L2 Hit Rate CE", id: TriageCompute.lts__average_t_sector_hit_rate_srcunit_ce_realtime, subMetrics: *pct_ratio }
    - { name: "L2 Hit Rate GCC", id: TriageCompute.lts__average_t_sector_hit_rate_srcunit_gcc_realtime, subMetrics: *pct_ratio }
    - { name: "L2 Hit Rate GPC", id: TriageCompute.lts__average_t_sector_hit_rate_srcnode_gpc_realtime, subMetrics: *pct_ratio }
    - { name: "L2 Hit Rate HUB", id: TriageCompute.lts__average_t_sector_hit_rate_srcnode_hub_realtime, subMetrics: *pct_ratio }
    - { name: "L2 Hit Rate TEX Atom", id: TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_atom_realtime, subMetrics: *pct_ratio }
    - { name: "L2 Hit Rate TEX Read", id: TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_read_realtime, subMetrics: *pct_ratio }
    - { name: "L2 Hit Rate TEX Write", id: TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_write_realtime, subMetrics: *pct_ratio }
    - { name: "L2 Lookup Miss", id: lts__t_sectors_lookup_miss_realtime, subMetrics: *counts }
    - { name: "L2 Sectors Throughput", id: lts__t_sectors_realtime, subMetrics: *throughput }
    - { name: "L2 Sectors CE", id: lts__t_sectors_srcunit_ce_realtime, subMetrics: *counts }
    - { name: "L2 Sectors GCC", id: lts__t_sectors_srcunit_gcc_realtime, subMetrics: *counts }
    - { name: "L2 Sectors HUB", id: lts__t_sectors_srcnode_hub_realtime, subMetrics: *counts }
    - { name: "L2 Sectors TEX", id: lts__t_sectors_srcunit_tex_realtime, subMetrics: *counts }
    - { name: "L2 Throughput", id: TriageCompute.lts__throughput, subMetrics: *throughput }
    - { name: "SM ALU Size 64B Pipe Throughput", id: sm__inst_executed_pipe_alu_size_64b_realtime, subMetrics: *throughput }
    - { name: "SM ALU Heavy Pipe Throughput", id: sm__inst_executed_pipe_aluheavy_realtime, subMetrics: *throughput }
    - { name: "SM Shared Atom Bandwidth", id: sm__bytes_mem_shared_cmd_atom_realtime, subMetrics: *bandwidth }
    - { name: "SM Shared Read Bandwidth", id: sm__bytes_mem_shared_cmd_read_realtime, subMetrics: *bandwidth }
    - { name: "SM DCC Requests Hit", id: sm__dcc_requests_lookup_hit, subMetrics: *counts }
    - { name: "SM DCC Requests Miss", id: sm__dcc_requests_lookup_miss, subMetrics: *counts }
    - { name: "SM FMA Pipe Throughput", id: sm__pipe_fma_cycles_active_realtime, subMetrics: *throughput }
    - { name: "SM FMA Heavy Pipe Throughput", id: sm__pipe_fmaheavy_cycles_active_realtime, subMetrics: *throughput }
    - { name: "SM Frequency", id: gpc__cycles_elapsed, subMetrics: *hertz }
    - { name: "SM Tensor Pipe Throughput", id: sm__pipe_tensor_cycles_active_realtime, subMetrics: *throughput }
    - { name: "SM Tensor HMMA Pipe Throughput", id: sm__inst_executed_pipe_tensor_subpipe_hmma_realtime, subMetrics: *throughput }
    - { name: "SM Tensor IMMA Pipe Throughput", id: sm__inst_executed_pipe_tensor_subpipe_imma_realtime, subMetrics: *throughput }
    - { name: "SM Throughput", id: TriageCompute.sm__throughput, subMetrics: *throughput }
    - { name: "SM Uniform Pipe Throughput", id: sm__inst_executed_pipe_uniform_realtime, subMetrics: *throughput }
    - { name: "SM XU Pipe Throughput", id: sm__inst_executed_pipe_xu_realtime, subMetrics: *throughput }
    - { name: "SMEM Bank Conflicts Atom", id: l1tex__data_bank_conflicts_pipe_lsu_mem_shared_op_atom, subMetrics: *counts }
    - { name: "SMEM Bank Conflicts LD", id: l1tex__data_bank_conflicts_pipe_lsu_mem_shared_op_ld, subMetrics: *counts }
    - { name: "SMEM Bank Conflicts LDGSTS", id: l1tex__data_bank_conflicts_pipe_lsu_mem_shared_op_ldgsts, subMetrics: *counts }
    - { name: "SMEM Bank Conflicts ST", id: l1tex__data_bank_conflicts_pipe_lsu_mem_shared_op_st, subMetrics: *counts }
    - { name: "XBAR to L2 Active", id: lts__xbar2lts_cycles_active, subMetrics: *throughput }
    - { name: "CTC RX Throughput User Data", id: ctc__rx_bytes_data_user, subMetrics: *bandwidth_no_peak }
    - { name: "CTC TX Throughput User Data", id: ctc__tx_bytes_data_user, subMetrics: *bandwidth_no_peak }

  schedulingHints:
    - domain: gpu_gpc_a
      counters:
        - 0xc17246f5eabf1db1
    - domain: gpu_gpc_b
      counters:
        - 0x661f688f6adeed10
        - 0x75ef2b41feee802c
    - domain: gpu_fbp_b
      counters:
        - 0xce4db9abddb0dd6d
