  metricGroups:
    - { name: "Overview" }
    - { name: "SM Frequency", metrics: ["SM Frequency"] }
    - { name: "Average Warps Active per SM", metrics: ["Average Warps Active per SM"] }
    - { name: "Total Warps Active", metrics: ["Total Warps Active"] }
    - { name: "Total Blocks Launched", metrics: ["Total Blocks Launched"] }
    - { name: "Average Blocks Active", metrics: ["Average Blocks Active"] }
    - { name: "Total Blocks Active", metrics: ["Total Blocks Active"] }
    - { name: "Total CGAs Launched", metrics: ["Total CGAs Launched"] }
    - { name: "Average CGAs Active", metrics: ["Average CGAs Active"] }
    - { name: "Total CGAs Active", metrics: ["Total CGAs Active"] }
    - { name: "SM" }
    - { name: "Executed IPC Active", metrics: ["Executed IPC Active"] }
    - { name: "Executed IPC Elapsed", metrics: ["Executed IPC Elapsed"] }
    - { name: "SM Throughput", metrics: ["SM Throughput"] }
    - { name: "SM ALU Heavy Pipe Throughput", metrics: ["SM ALU Heavy Pipe Throughput"] }
    - { name: "SM ALU Size 64B Pipe Throughput", metrics: ["SM ALU Size 64B Pipe Throughput"] }
    - { name: "SM FMA Pipe Throughput", metrics: ["SM FMA Pipe Throughput"] }
    - { name: "SM FMA Heavy Pipe Throughput", metrics: ["SM FMA Heavy Pipe Throughput"] }
    - { name: "SM Tensor Pipe Throughput", metrics: ["SM Tensor Pipe Throughput"] }
    - { name: "SM Tensor HMMA Pipe Throughput", metrics: ["SM Tensor HMMA Pipe Throughput"] }
    - { name: "SM Tensor IMMA Pipe Throughput", metrics: ["SM Tensor IMMA Pipe Throughput"] }
    - { name: "SM Uniform Pipe Throughput", metrics: ["SM Uniform Pipe Throughput"] }
    - { name: "SM XU Pipe Throughput", metrics: ["SM XU Pipe Throughput"] }
    - name: SM Shared Bandwidth
      description: Shared memory bandwidth by access type
      subMetrics: *bandwidth
      aggregationOp: max
      metrics:
        - SM Shared Atom Bandwidth
        - SM Shared Read Bandwidth
    - name: SM DCC Hit Miss
      description: Data Constant Case hits and misses
      subMetrics: *counts
      aggregationOp: sum
      metrics:
        - SM DCC Requests Hit
        - SM DCC Requests Miss
    - { name: "L1" }
    - { name: "L1 LSU Writeback Active", metrics: ["L1 LSU Writeback Active"] }
    - { name: "L1 TEX Writeback Active", metrics: ["L1 TEX Writeback Active"] }
    - { name: "L1 Hit Miss" }
    - { name: "L1 Lookup Hit Throughput", metrics: ["L1 Lookup Hit Throughput"] }
    - { name: "L1 Lookup Miss Throughput", metrics: ["L1 Lookup Miss Throughput"] }
    - name: L1 Lookup Hit Miss
      description: L1 cache lookup hits by access type, and misses
      subMetrics: *counts
      aggregationOp: sum
      metrics:
        - L1 Global LD Hit
        - L1 Global ST Hit
        - L1 LDGSTS Hit
        - L1 Local LD Hit
        - L1 Local ST Hit
        - L1 Surface LD Hit
        - L1 Surface ST Hit
        - L1 Texture LD Hit
        - L1 Texture TEX Hit
        - L1 Lookup Miss
    - name: SMEM Bank Conflicts
      description: Shared memory bank conflicts by access type
      subMetrics: *counts
      aggregationOp: sum
      metrics:
        - SMEM Bank Conflicts Atom
        - SMEM Bank Conflicts LD
        - SMEM Bank Conflicts LDGSTS
        - SMEM Bank Conflicts ST
    - { name: "L1 Wavefronts (Data)"}
    - { name: "L1 Wavefronts Throughput", metrics: ["L1 Wavefronts Throughput"] }
    - name: L1 Wavefronts
      description: L1 cache wavefronts by access type
      subMetrics: *counts
      aggregationOp: sum
      metrics:
        - L1 Wavefronts LGDS
        - L1 Wavefronts Shared
        - L1 Wavefronts Shared Atom
        - L1 Wavefronts Shared LD
        - L1 Wavefronts Shared LDGSTS
        - L1 Wavefronts Shared Misc
        - L1 Wavefronts Shared ST
        - L1 Wavefronts TEX
    - { name: "L2" }
    - { name: "L2 Throughput", metrics: ["L2 Throughput"] }
    - { name: "L2 Sectors Throughput", metrics: ["L2 Sectors Throughput"] }
    - name: L2 Sectors
      description: L2 cache sectors by source unit
      subMetrics: *counts
      aggregationOp: sum
      metrics:
        - L2 Sectors CE
        - L2 Sectors GCC
        - L2 Sectors HUB
        - L2 Sectors TEX
    - { name: "L2 to XBAR Active", metrics: ["L2 to XBAR Active"] }
    - { name: "XBAR to L2 Active", metrics: ["XBAR to L2 Active"] }
    - { name: "L2 Lookup Miss", metrics: ["L2 Lookup Miss"] }
    - { name: "L2 Hit Rate CE", metrics: ["L2 Hit Rate CE"] }
    - { name: "L2 Hit Rate GCC", metrics: ["L2 Hit Rate GCC"] }
    - { name: "L2 Hit Rate GPC", metrics: ["L2 Hit Rate GPC"] }
    - { name: "L2 Hit Rate HUB", metrics: ["L2 Hit Rate HUB"] }
    - { name: "L2 Hit Rate TEX Atom", metrics: ["L2 Hit Rate TEX Atom"] }
    - { name: "L2 Hit Rate TEX Read", metrics: ["L2 Hit Rate TEX Read"] }
    - { name: "L2 Hit Rate TEX Write", metrics: ["L2 Hit Rate TEX Write"] }
    - name: CTC Throughput
      subMetrics: *bandwidth_no_peak
      aggregationOp: max
      metrics:
        - CTC RX Throughput User Data
        - CTC TX Throughput User Data

  timelineViews:
    - name: Default
      rows:
        - metricGroup: Overview
          children:
            - SM Frequency
            - Average Warps Active per SM
            - Total Warps Active
            - Total Blocks Launched
            - Average Blocks Active
            - Total Blocks Active
            - Total CGAs Launched
            - Average CGAs Active
            - Total CGAs Active
        - metricGroup: SM
          children:
            - Executed IPC Active
            - Executed IPC Elapsed
            - SM Throughput
            - SM ALU Heavy Pipe Throughput
            - SM ALU Size 64B Pipe Throughput
            - SM FMA Pipe Throughput
            - SM FMA Heavy Pipe Throughput
            - SM Tensor Pipe Throughput
            - SM Tensor HMMA Pipe Throughput
            - SM Tensor IMMA Pipe Throughput
            - SM Uniform Pipe Throughput
            - SM XU Pipe Throughput
            - SM Shared Bandwidth
            - SM DCC Hit Miss
        - metricGroup: L1
          children:
            - L1 LSU Writeback Active
            - L1 TEX Writeback Active
        - metricGroup: L1 Hit Miss
          children:
            - L1 Lookup Hit Throughput
            - L1 Lookup Miss Throughput
            - L1 Lookup Hit Miss
            - SMEM Bank Conflicts
        - metricGroup: L1 Wavefronts (Data)
          children:
            - L1 Wavefronts Throughput
            - L1 Wavefronts
        - metricGroup: L2
          children:
            - L2 Throughput
            - L2 Sectors Throughput
            - L2 Sectors
            - L2 to XBAR Active
            - XBAR to L2 Active
        - metricGroup: L2 Lookup Miss
          children:
            - L2 Hit Rate CE
            - L2 Hit Rate GCC
            - L2 Hit Rate GPC
            - L2 Hit Rate HUB
            - L2 Hit Rate TEX Atom
            - L2 Hit Rate TEX Read
            - L2 Hit Rate TEX Write
        - CTC Throughput
